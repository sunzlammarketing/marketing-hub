---
// Trang danh sách Skill AI. Dữ liệu ở src/data/skills.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import PaymentModal from '../components/PaymentModal.astro';
import { SKILLS, skillUrl } from '../data/skills';
---

<BaseLayout
  title="Skill AI cho Marketing"
  description="Claude Skill do Sunz Làm Marketing xây dựng: cài một lần, Claude viết content bán hàng đúng quy trình, đúng pháp lý quảng cáo Việt Nam."
>
  <section class="page-head">
    <div class="container">
      <span class="pill pill-green"><span data-i18n-vi="Đang mở bán" data-i18n-en="Now available">Đang mở bán</span></span>
      <h1><span data-i18n-vi="Skill AI" data-i18n-en="AI Skills">Skill AI</span> <span class="hl" data-i18n-vi="cho Marketing" data-i18n-en="for Marketing">cho Marketing</span></h1>
      <p data-i18n-vi="Cài một lần vào Claude, dùng mãi cho công việc Marketing hằng ngày." data-i18n-en="Install once into Claude, use every day for your marketing work.">
        Cài một lần vào Claude, dùng mãi cho công việc Marketing hằng ngày.
      </p>
    </div>
  </section>

  <section class="container" style="padding-block:var(--space-content-top) var(--space-section)">
    <div class="pd-grid">
      {SKILLS.map((s) => <ProductCard product={s} href={skillUrl(s)} />)}
    </div>
  </section>
  <PaymentModal />
</BaseLayout>

<style>
  .pd-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 960px) {
    .pd-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .pd-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
