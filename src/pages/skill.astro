---
// Trang danh sách Skill AI. Dữ liệu ở src/data/skills.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import PaymentModal from '../components/PaymentModal.astro';
import { SKILLS, skillUrl } from '../data/skills';
---

<BaseLayout
  title="Skill AI cho Marketing"
  description="Claude Skill do Sunz Làm Marketing xây dựng: cài một lần, Claude viết content bán hàng đúng quy trình, đúng pháp lý quảng cáo Việt Nam."
>
  <section class="page-head">
    <div class="container">
      <h1 data-i18n-vi="Skill AI cho Marketing" data-i18n-en="AI Skills for Marketing">Skill AI cho Marketing</h1>
      <p data-i18n-vi="Cài một lần vào Claude, dùng mãi cho công việc Marketing hằng ngày." data-i18n-en="Install once into Claude, use every day for your marketing work.">
        Cài một lần vào Claude, dùng mãi cho công việc Marketing hằng ngày.
      </p>
    </div>
  </section>

  <section class="container" style="padding-block:var(--space-content-top) var(--space-section)">
    <div class="pd-grid">
      {SKILLS.map((s) => <ProductCard product={s} href={skillUrl(s)} />)}
    </div>
  </section>
  <PaymentModal />
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-head-top) var(--space-head-bottom);
    text-align: center;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-head h1 {
    font-size: clamp(1.8rem, 4.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .page-head p {
    color: var(--ink-soft);
    margin: 0 auto;
    max-width: 720px;
  }
  .pd-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 960px) {
    .pd-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .pd-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
