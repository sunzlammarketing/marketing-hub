---
// Trang Tài liệu: lưới thẻ sản phẩm (ảnh · nhãn · tên · mô tả · giá · Mua ngay).
// Dữ liệu sản phẩm ở src/data/products.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import PaymentModal from '../components/PaymentModal.astro';
import { PRODUCTS } from '../data/products';
---

<BaseLayout
  title="Tài liệu Marketing"
  description="Template, ebook và checklist Marketing thực chiến của Sunz Làm Marketing — dùng được ngay cho công việc."
>
  <section class="page-head">
    <div class="container">
      <h1 data-i18n="resources.title">Tài liệu Marketing</h1>
      <p data-i18n="resources.lead">Template, ebook và checklist thực chiến — mua về là dùng được ngay.</p>
    </div>
  </section>

  <section class="container" style="padding-block:var(--space-content-top) var(--space-section)">
    <div class="pd-grid">
      {PRODUCTS.map((p) => <ProductCard product={p} />)}
    </div>
  </section>
  <PaymentModal />
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-head-top) var(--space-head-bottom);
    text-align: center;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-head h1 {
    font-size: clamp(1.8rem, 4.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .page-head p {
    color: var(--ink-soft);
    margin: 0 auto;
    max-width: 720px;
  }
  .pd-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 960px) {
    .pd-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .pd-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>

