---
// Trang chi tiết từng tài liệu: /tai-lieu/<slug>. Dữ liệu ở src/data/products.ts
// Các mục Giới thiệu / Bạn nhận được gì / Phù hợp với ai / ảnh chụp thêm chỉ hiện khi có dữ liệu.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCover from '../../components/ProductCover.astro';
import ProductCard from '../../components/ProductCard.astro';
import BuyButton from '../../components/BuyButton.astro';
import PaymentModal from '../../components/PaymentModal.astro';
import { PRODUCTS, formatVnd, effectivePrice, type Product } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props as { product: Product };
const ep = effectivePrice(p);
const off = ep.off;
const related = PRODUCTS.filter((x) => x.slug !== p.slug).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name.vi,
  description: p.desc.vi,
  brand: { '@type': 'Brand', name: 'Sunz Làm Marketing' },
  ...(p.price != null && {
    offers: { '@type': 'Offer', price: p.price, priceCurrency: 'VND', availability: 'https://schema.org/InStock' },
  }),
};
---

<BaseLayout
  title={p.name.vi}
  description={p.desc.vi}
  image={p.image?.endsWith('/cover.webp') ? p.image.replace(/cover\.webp$/, 'og.jpg') : p.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Nội dung chính của trang (article) — tách khỏi danh sách "Tài liệu khác" bên dưới -->
  <article class="container pdx">

    <div class="pdx-grid">
      <div class="pdx-media-col">
        {p.image ? (
          <button type="button" class="pdx-media pdx-preview" data-preview-src={p.image} aria-label="Phóng to ảnh bìa" data-preview-alt={p.name.vi}>
            <ProductCover product={p} size="large" />
          </button>
        ) : (
          <div class="pdx-media"><ProductCover product={p} size="large" /></div>
        )}
        {p.gallery && p.gallery.length > 0 && (
          <div class="pdx-gallery">
            {p.gallery.map((src, i) => (
              <button type="button" class="pdx-preview" data-preview-src={src} data-preview-alt={`${p.name.vi}: trang xem trước ${i + 1}`} aria-label={`Phóng to ảnh ${i + 1}`}>
                {/* Ảnh nhỏ <tên>-thumb.webp (480×360) cho dải xem trước; bấm mở ảnh trang đầy đủ */}
                <img
                  src={src.endsWith('.webp') ? src.replace(/\.webp$/, '-thumb.webp') : src}
                  alt={`${p.name.vi}: trang xem trước ${i + 1}`}
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="360"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="pdx-info">
        <h1 data-i18n-vi={p.name.vi} data-i18n-en={p.name.en}>{p.name.vi}</h1>
        <p class="pdx-desc" data-i18n-vi={p.desc.vi} data-i18n-en={p.desc.en}>{p.desc.vi}</p>

        <dl class="pdx-meta">
          <div>
            <dt data-i18n-vi="Định dạng" data-i18n-en="Format">Định dạng</dt>
            <dd data-i18n-vi={p.type.vi} data-i18n-en={p.type.en}>{p.type.vi}</dd>
          </div>
          <div>
            <dt data-i18n-vi="Tác giả" data-i18n-en="By">Tác giả</dt>
            <dd>Sunz Làm Marketing</dd>
          </div>
        </dl>

        <div class="pdx-buy">
          <div>
            <span class="pdx-price-label" data-i18n-vi="Giá" data-i18n-en="Price">Giá</span>
            {ep.price === 0 ? (
              <span class="pdx-price" data-i18n-vi="Miễn phí" data-i18n-en="Free">Miễn phí</span>
            ) : ep.price != null ? (
              <span class="pdx-price-row" data-price-box data-until={ep.promo?.until} data-regular={p.price != null ? formatVnd(p.price) : undefined}>
                <span class="pdx-price" data-pnow>{formatVnd(ep.price)}</span>
                {off && (
                  <span class="pdx-old" data-pold>
                    <s>{formatVnd(ep.old!)}</s> <b class="pdx-off">-{off}%</b>
                  </span>
                )}
              </span>
            ) : (
              <span class="pdx-price pdx-price-ask" data-i18n-vi="Liên hệ" data-i18n-en="Contact us">Liên hệ</span>
            )}
          </div>
          <BuyButton product={p} size="lg" />
        </div>

        {ep.price === 0 ? (
          <div class="pdx-how">
            <b data-i18n-vi="Cách nhận tài liệu" data-i18n-en="How to get it">Cách nhận tài liệu</b>
            <p data-i18n-vi="Bấm “Nhận ngay” và nhắn Sunz qua Messenger để nhận tài liệu miễn phí."
               data-i18n-en="Tap “Get it free” and message Sunz on Messenger to request the free resource.">
              Bấm “Nhận ngay” và nhắn Sunz qua Messenger để nhận tài liệu miễn phí.
            </p>
          </div>
        ) : (
        <div class="pdx-how">
          <b data-i18n-vi="Cách mua" data-i18n-en="How to buy">Cách mua</b>
          <ol>
            <li data-i18n-vi="Bấm “Mua ngay”, nhập email và số điện thoại." data-i18n-en="Tap “Buy now”, enter your email and phone.">
              Bấm “Mua ngay”, nhập email và số điện thoại.
            </li>
            <li data-i18n-vi="Quét mã QR chuyển khoản, số tiền và nội dung đã điền sẵn." data-i18n-en="Scan the QR to pay — amount and note are pre-filled.">
              Quét mã QR chuyển khoản, số tiền và nội dung đã điền sẵn.
            </li>
            <li data-i18n-vi="Nhận link tải tài liệu qua email sau khi Sunz xác nhận." data-i18n-en="Get the download link by email once Sunz confirms.">
              Nhận link tải tài liệu qua email sau khi Sunz xác nhận.
            </li>
          </ol>
        </div>
        )}
      </div>
    </div>

    {(p.intro || p.includes || p.forWho) && (
      <div class="pdx-details">
        {p.intro && (
          <div class="pdx-block pdx-wide">
            <h2 data-i18n-vi="Giới thiệu" data-i18n-en="Overview">Giới thiệu</h2>
            <p data-i18n-vi={p.intro.vi} data-i18n-en={p.intro.en}>{p.intro.vi}</p>
          </div>
        )}
        {p.includes && (
          <div class="pdx-block">
            <h2 data-i18n-vi="Bạn nhận được gì" data-i18n-en="What you get">Bạn nhận được gì</h2>
            <ul class="pdx-list pdx-check">
              {p.includes.vi.map((t, i) => (
                <li data-i18n-vi={t} data-i18n-en={p.includes!.en[i] ?? t}>{t}</li>
              ))}
            </ul>
          </div>
        )}
        {p.forWho && (
          <div class="pdx-block">
            <h2 data-i18n-vi="Phù hợp với ai" data-i18n-en="Who it's for">Phù hợp với ai</h2>
            <ul class="pdx-list pdx-dot">
              {p.forWho.vi.map((t, i) => (
                <li data-i18n-vi={t} data-i18n-en={p.forWho!.en[i] ?? t}>{t}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </article>

  {related.length > 0 && (
    <section class="container pdx-related">
      <div class="pdx-related-head">
        <h2 data-i18n-vi="Tài liệu khác" data-i18n-en="More resources">Tài liệu khác</h2>
        <a href="/tai-lieu" class="pdx-all" data-i18n-vi="Xem tất cả →" data-i18n-en="View all →">Xem tất cả →</a>
      </div>
      <div class="pdx-related-grid">
        {related.map((r) => <ProductCard product={r} />)}
      </div>
    </section>
  )}
  <dialog class="pdx-lightbox" aria-label="Xem ảnh tài liệu" data-preview-dialog>
    <button type="button" class="pdx-lightbox-close" data-preview-close aria-label="Đóng">×</button>
    <button type="button" class="pdx-lightbox-prev" data-preview-prev aria-label="Ảnh trước">‹</button>
    <div class="pdx-zoom-controls">
      <button type="button" data-zoom-out aria-label="Thu nhỏ ảnh">−</button>
      <button type="button" data-zoom-reset aria-label="Khôi phục kích thước ảnh" aria-live="polite">100%</button>
      <button type="button" data-zoom-in aria-label="Phóng to ảnh">+</button>
    </div>
    <figure>
      <div class="pdx-image-viewport" data-image-viewport tabindex="0" aria-label="Ảnh phóng to, cuộn để xem nội dung">
        <img data-preview-image alt="" />
      </div>
      <figcaption data-preview-count aria-live="polite"></figcaption>
    </figure>
    <button type="button" class="pdx-lightbox-next" data-preview-next aria-label="Ảnh tiếp theo">›</button>
  </dialog>
  <PaymentModal />
</BaseLayout>

<style>
  .pdx-preview { display: block; width: 100%; padding: 0; cursor: zoom-in; background: transparent; border: 0; }
  .pdx-preview:focus-visible { outline: 3px solid var(--brand); outline-offset: 4px; }
  .pdx-lightbox { padding: 56px 64px 24px; border: 0; border-radius: 20px; width: min(1100px, 96vw); max-width: 96vw; height: 92vh; height: 92dvh; max-height: 96dvh; background: #141322; color: #fff; overflow: hidden; box-sizing: border-box; }
  .pdx-lightbox::backdrop { background: rgba(0, 0, 0, .85); }
  .pdx-lightbox figure { margin: 0; height: 100%; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .pdx-image-viewport { width: 100%; min-height: 0; flex: 1; overflow: auto; overscroll-behavior: contain; }
  .pdx-lightbox img { display: block; max-width: none; max-height: none; margin: auto; object-fit: contain; }
  .pdx-zoom-controls { position: absolute; top: 8px; left: 12px; display: flex; gap: 6px; }
  .pdx-zoom-controls button { position: static !important; font-size: 22px !important; }
  .pdx-zoom-controls button[data-zoom-reset] { width: 70px; border-radius: 12px; font-size: 15px !important; }
  .pdx-zoom-controls button:disabled { opacity: .4; cursor: default; }
  .pdx-lightbox figcaption { flex-shrink: 0; font-weight: 700; }
  .pdx-lightbox button { position: absolute; width: 44px; height: 44px; border: 1px solid #ffffff55; border-radius: 50%; background: #343146; color: white; cursor: pointer; font-size: 32px; display: grid; place-items: center; padding: 0; line-height: 1; }
  .pdx-lightbox button[hidden] { display: none; }
  .pdx-lightbox button:focus-visible { outline: 3px solid #a5b4fc; outline-offset: 3px; }
  .pdx-lightbox-close { top: 8px; right: 12px; }
  .pdx-lightbox-prev { left: 8px; top: calc(50% - 22px); }
  .pdx-lightbox-next { right: 8px; top: calc(50% - 22px); }
  @media (max-width: 600px) {
    .pdx-lightbox { padding: 56px 8px 70px; width: 96vw; }
    .pdx-lightbox-prev { top: auto; bottom: 12px; left: calc(50% - 60px); }
    .pdx-lightbox-next { top: auto; bottom: 12px; right: calc(50% - 60px); }
  }

  .pdx {
    padding-top: var(--space-head-top);
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-bottom: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .crumbs a {
    color: var(--ink-soft);
  }
  .crumbs span {
    margin-inline: 4px;
  }
  .pdx-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .pdx-media {
    aspect-ratio: 4 / 3;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: var(--bg-soft);
  }
  .pdx-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 12px;
  }
  .pdx-gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top; /* trang PDF dọc: giữ phần đầu trang */
    border-radius: 12px;
    border: 1px solid var(--border);
  }

  .pdx-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #e2553b;
    background: color-mix(in srgb, #ff7759 12%, transparent);
    border: 1px solid color-mix(in srgb, #ff7759 35%, transparent);
    padding: 7px 14px;
    border-radius: 999px;
  }
  .pdx-info h1 {
    margin: 14px 0 12px;
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    font-weight: 900;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .pdx-desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.04rem;
    line-height: 1.7;
  }
  .pdx-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 20px 0;
    padding: 14px 0;
    border-block: 1px solid var(--border);
  }
  .pdx-meta dt {
    font-size: 0.78rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pdx-meta dd {
    margin: 2px 0 0;
    font-weight: 700;
  }
  .pdx-buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 18px 20px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--brand) 8%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--brand) 25%, var(--border));
  }
  .pdx-price-label {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .pdx-price {
    font-size: 2rem;
    font-weight: 900;
    color: var(--brand);
    letter-spacing: -0.02em;
  }
  .pdx-price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pdx-old {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    color: var(--ink-faint);
  }
  .pdx-old s {
    text-decoration-thickness: 2px;
  }
  .pdx-off {
    font-size: 0.8rem;
    font-weight: 800;
    color: #fff;
    background: #ef4444;
    padding: 3px 8px;
    border-radius: 8px;
  }
  .pdx-price-ask {
    font-size: 1.5rem;
  }
  .pdx-how {
    margin-top: 18px;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .pdx-how b {
    color: var(--ink);
  }
  .pdx-how ol {
    margin: 8px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 4px;
  }

  .pdx-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  .pdx-block {
    padding: 28px 30px;
    border-radius: 28px;
    border: 1px solid var(--border);
    background: var(--panel);
    backdrop-filter: blur(8px);
    box-shadow: var(--panel-shadow);
  }
  .pdx-wide {
    grid-column: 1 / -1;
  }
  .pdx-block h2 {
    margin: 0 0 12px;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.01em;
  }
  .pdx-block p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.75;
  }
  .pdx-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    color: var(--ink-soft);
  }
  .pdx-list li {
    position: relative;
    padding-left: 26px;
  }
  .pdx-check li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #10b981;
    font-weight: 900;
  }
  .pdx-dot li::before {
    content: '•';
    position: absolute;
    left: 8px;
    color: var(--brand);
    font-weight: 900;
  }

  .pdx-related {
    padding-block: var(--space-section);
  }
  .pdx-related-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .pdx-related-head h2 {
    margin: 0;
    font-size: clamp(1.3rem, 2.6vw, 1.6rem);
    font-weight: 800;
  }
  .pdx-all {
    font-weight: 700;
  }
  .pdx-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  :global([data-theme='dark']) .pdx-tag {
    color: #ffa48f;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .pdx-tag {
      color: #ffa48f;
    }
  }
  @media (max-width: 900px) {
    .pdx-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .pdx-related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .pdx-details,
    .pdx-related-grid {
      grid-template-columns: 1fr;
    }
    .pdx-media {
      border-radius: 22px;
    }
    .pdx-buy :global(.buy-btn) {
      flex: 1;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-preview-dialog]');
  const previews = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-preview-src]'));
  const image = dialog?.querySelector<HTMLImageElement>('[data-preview-image]');
  const count = dialog?.querySelector<HTMLElement>('[data-preview-count]');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-preview-close]');
  const prev = dialog?.querySelector<HTMLButtonElement>('[data-preview-prev]');
  const next = dialog?.querySelector<HTMLButtonElement>('[data-preview-next]');
  const viewport = dialog?.querySelector<HTMLElement>('[data-image-viewport]');
  const zoomIn = dialog?.querySelector<HTMLButtonElement>('[data-zoom-in]');
  const zoomOut = dialog?.querySelector<HTMLButtonElement>('[data-zoom-out]');
  const zoomReset = dialog?.querySelector<HTMLButtonElement>('[data-zoom-reset]');
  if (dialog && image && count && close && prev && next && viewport && zoomIn && zoomOut && zoomReset && previews.length) {
    let zoom = 1;
    const renderZoom = () => {
      zoomReset.textContent = `${Math.round(zoom * 100)}%`;
      zoomOut.disabled = zoom <= 1;
      zoomIn.disabled = zoom >= 4;
      if (!image.naturalWidth || !image.naturalHeight || !viewport.clientWidth || !viewport.clientHeight) return;
      const fit = Math.min(viewport.clientWidth / image.naturalWidth, viewport.clientHeight / image.naturalHeight);
      image.style.width = `${image.naturalWidth * fit * zoom}px`;
      image.style.height = `${image.naturalHeight * fit * zoom}px`;
    };
    const resetZoom = () => {
      zoom = 1;
      renderZoom();
      viewport.scrollTop = viewport.scrollLeft = 0;
    };
    zoomIn.addEventListener('click', () => { zoom = Math.min(4, zoom + .5); renderZoom(); });
    zoomOut.addEventListener('click', () => { zoom = Math.max(1, zoom - .5); renderZoom(); });
    zoomReset.addEventListener('click', resetZoom);
    image.addEventListener('load', renderZoom);
    new ResizeObserver(() => { if (dialog.open) renderZoom(); }).observe(viewport);
    let index = 0;
    let opener: HTMLButtonElement | null = null;
    let oldOverflow = '';
    const show = (at: number) => {
      resetZoom();
      index = (at + previews.length) % previews.length;
      image.src = previews[index].dataset.previewSrc || '';
      image.alt = previews[index].dataset.previewAlt || '';
      count.textContent = `${index + 1} / ${previews.length}`;
      prev.hidden = next.hidden = previews.length < 2;
    };
    previews.forEach((button, at) => button.addEventListener('click', () => {
      opener = button;
      show(at);
      oldOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
      renderZoom();
    }));
    close.addEventListener('click', () => dialog.close());
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + (event.key === 'ArrowLeft' ? -1 : 1));
      }
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = oldOverflow;
      opener?.focus();
    });
  }
</script>
