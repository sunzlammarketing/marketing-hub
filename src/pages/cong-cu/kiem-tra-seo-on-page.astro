---
// Công cụ kiểm tra SEO on-page 30 điểm: /cong-cu/kiem-tra-seo-on-page
// - Logic chấm: src/lib/seo-checker/ (chạy trên trình duyệt). Nội dung 30 điểm: src/data/seo-checklist-30.json
// - Bước A: chế độ "Dán nội dung". Bước B (sau): chế độ "Nhập URL" qua Worker /api/seo/fetch.
// - Kết quả dựng bằng innerHTML → CSS kết quả để trong <style is:global> giới hạn bằng #seo-app.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL as SITE } from '../../data/site';

// Brief đề xuất title 72 ký tự → chính công cụ chấm mục 6 'Chưa đạt' (>70). Rút gọn còn 50 ký tự.
const PAGE_TITLE = 'Kiểm tra SEO on-page miễn phí, chấm 30 điểm | Sunz';
const PAGE_DESC =
  'Công cụ kiểm tra SEO on-page miễn phí: dán bài viết, chấm 30 điểm theo checklist, chỉ rõ mục chưa đạt và cách sửa title, meta, heading, link, ảnh.';
const PUBLISHED = '2026-10-11';
const UPDATED = '2026-10-11';
const URL_PATH = '/cong-cu/kiem-tra-seo-on-page';
const EBOOK = '/tai-lieu/checklist-seo-on-page';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Công cụ kiểm tra SEO on-page 30 điểm',
    url: SITE + URL_PATH,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Mọi trình duyệt',
    inLanguage: 'vi',
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'VND' },
    publisher: { '@type': 'Organization', name: 'Sunz Làm Marketing' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Kiểm tra SEO on-page cho bài viết',
    description: PAGE_DESC,
    author: { '@type': 'Organization', name: 'Sunz Làm Marketing', url: SITE + '/gioi-thieu' },
    publisher: { '@type': 'Organization', name: 'Sunz Làm Marketing' },
    datePublished: PUBLISHED,
    dateModified: UPDATED,
    mainEntityOfPage: SITE + URL_PATH,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: SITE + '/' },
      { '@type': 'ListItem', position: 2, name: 'Công cụ', item: SITE + '/cong-cu' },
      { '@type': 'ListItem', position: 3, name: 'Kiểm tra SEO on-page', item: SITE + URL_PATH },
    ],
  },
];
const fmtDate = (d: string) => d.split('-').reverse().join('/');
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} exactTitle>
  <Fragment slot="head">
    <meta name="author" content="Sunz Làm Marketing" />
    <meta property="article:published_time" content={PUBLISHED} />
    <meta property="article:modified_time" content={UPDATED} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <article id="seo-app">
    <section class="page-head">
      <div class="container">
        <h1>Kiểm tra <span class="hl">SEO on-page</span> cho bài viết</h1>
        <p>Công cụ kiểm tra SEO on-page miễn phí: dán bài viết hoặc nhập URL, công cụ chấm theo 30 điểm của <a href={EBOOK}>Checklist 30 điểm tối ưu SEO on-page</a> và chỉ rõ cần sửa gì trước khi đăng.</p>
        <p class="sc-byline">
          Tác giả <a href="/gioi-thieu" rel="author" class="author">Sunz Làm Marketing</a> ·
          Đăng <time datetime={PUBLISHED}>{fmtDate(PUBLISHED)}</time> ·
          Cập nhật <time datetime={UPDATED}>{fmtDate(UPDATED)}</time>
        </p>
      </div>
    </section>

    <section class="container sc-wrap">
      <!-- ===== FORM ===== -->
      <form class="panel sc-form" id="sc-form" novalidate>
        <div class="sc-modes" role="tablist" aria-label="Chế độ kiểm tra">
          <button type="button" class="sc-mode active" role="tab" aria-selected="true" data-mode="paste">✍️ Dán nội dung</button>
          <button type="button" class="sc-mode" role="tab" aria-selected="false" data-mode="url">🔗 Nhập URL</button>
        </div>

        <div class="sc-grid">
          <label class="sc-field sc-wide" data-only="url" hidden>
            <span>URL bài viết <b class="req">*</b></span>
            <input name="pageUrl" type="url" inputmode="url" placeholder="https://tenmien.vn/bai-viet-can-kiem-tra" autocomplete="off" />
          </label>
          <label class="sc-field sc-wide">
            <span>Từ khoá chính <b class="req">*</b></span>
            <input name="keyword" required placeholder="vd: kem chống nắng cho da dầu" autocomplete="off" />
          </label>
          <label class="sc-field sc-wide" data-only="paste">
            <span>Title SEO <em class="sc-count" data-count="title"></em></span>
            <input name="title" placeholder="vd: Kem chống nắng cho da dầu: 7 tiêu chí chọn đúng | Thương hiệu" autocomplete="off" />
          </label>
          <label class="sc-field sc-wide" data-only="paste">
            <span>Meta description <em class="sc-count" data-count="metaDescription"></em></span>
            <textarea name="metaDescription" rows="2" placeholder="Tóm tắt lợi ích của bài + từ khoá + lời kêu gọi, khoảng 140–160 ký tự"></textarea>
          </label>
          <label class="sc-field" data-only="paste">
            <span>URL hoặc slug</span>
            <input name="url" placeholder="vd: tenmien.vn/kem-chong-nang-cho-da-dau" autocomplete="off" />
          </label>
          <label class="sc-field" data-only="paste">
            <span>Tên miền website</span>
            <input name="domain" placeholder="vd: tenmien.vn (để nhận link nội bộ)" autocomplete="off" />
          </label>
        </div>

        <p class="sc-url-note" data-only="url" hidden>
          Công cụ tải trang, tự đọc title, meta, heading, link, ảnh và chấm thêm 9 mục kỹ thuật (canonical, Open Graph, tác giả, ngày đăng,
          lập chỉ mục, tốc độ PageSpeed, schema…). Mỗi IP được kiểm tra <b>10 URL mỗi giờ</b>; công cụ không lưu URL bạn nhập.
        </p>
        <div class="sc-content" data-only="paste">
          <div class="sc-content-head">
            <span class="sc-label">Nội dung bài <b class="req">*</b></span>
            <div class="sc-subtabs" role="tablist">
              <button type="button" class="active" data-sub="rich">Dán từ Docs/Word</button>
              <button type="button" data-sub="html">Dán HTML</button>
            </div>
          </div>
          <div
            id="sc-editor"
            class="sc-editor prose"
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-label="Nội dung bài viết"
            data-placeholder="Copy bài từ Google Docs hoặc Word rồi dán vào đây: giữ nguyên H1/H2/H3, danh sách, link và ảnh."
          ></div>
          <textarea id="sc-html" class="sc-html" rows="12" hidden placeholder="<h1>Tiêu đề bài</h1>&#10;<p>Đoạn mở bài...</p>"></textarea>
          <p class="sc-hint">Nội dung chỉ được chấm ngay trên trình duyệt của bạn, không gửi đi đâu và không lưu lại.</p>
        </div>

        <p class="sc-err" id="sc-err" hidden></p>
        <div class="sc-actions">
          <button type="submit" class="btn btn-primary sc-run">Chấm điểm 30 mục →</button>
          <button type="button" class="btn btn-ghost" id="sc-clear">Xoá nội dung</button>
        </div>
      </form>

      <!-- ===== KẾT QUẢ (dựng bằng script) ===== -->
      <div id="sc-result" class="sc-result" hidden aria-live="polite"></div>

      <!-- ===== CTA ===== -->
      <aside class="sc-cta">
        <div>
          <b>Muốn hiểu sâu từng điểm, kèm ví dụ đúng/sai và template chấm điểm?</b>
          <p>Ebook Checklist 30 điểm tối ưu SEO on-page giải thích vì sao, cách làm và ví dụ cụ thể cho từng mục.</p>
        </div>
        <a href={EBOOK} class="btn sc-cta-btn">Xem ebook Checklist 30 điểm →</a>
      </aside>

      <!-- ===== HƯỚNG DẪN + FAQ (nội dung cho người đọc và SEO của chính trang) ===== -->
      <section class="panel sc-guide prose">
        <h2>Cách dùng công cụ kiểm tra SEO on-page</h2>
        <p>
          Công cụ chấm bài viết theo đúng 30 điểm trong checklist SEO on-page của Sunz, chia 6 nhóm: từ khoá và ý định tìm kiếm,
          tiêu đề – meta – URL, cấu trúc trình bày, chất lượng nội dung, liên kết – hình ảnh và kỹ thuật. Mỗi mục có số điểm theo mức
          ưu tiên: Bắt buộc 3 điểm, Quan trọng 2 điểm, Nên có 1 điểm. Các tiêu chí dựa trên
          <a href="https://developers.google.com/search/docs/fundamentals/seo-starter-guide?hl=vi" target="_blank" rel="noopener">hướng dẫn SEO cơ bản của Google Search Central</a>.
        </p>
        <ol>
          <li><strong>Chọn chế độ</strong>: “Dán nội dung” cho bài chưa đăng, hoặc “Nhập URL” cho bài đã lên web (chấm thêm canonical, tốc độ, schema…).</li>
          <li><strong>Nhập từ khoá chính</strong> mà bài muốn lên top, cùng title SEO, meta description và URL dự kiến.</li>
          <li><strong>Dán nội dung</strong> từ Google Docs hoặc Word vào ô soạn thảo. Công cụ giữ nguyên heading, danh sách, link và ảnh, đồng thời bỏ định dạng thừa.</li>
          <li><strong>Bấm “Chấm điểm”</strong> để xem điểm tổng, xếp loại và danh sách mục cần ưu tiên sửa.</li>
          <li><strong>Tự kiểm tra các mục còn lại</strong>: những việc cần mắt người (ý định tìm kiếm, nội dung gốc…) hiện dạng ô tick kèm hướng dẫn. Điểm cập nhật ngay khi bạn tick.</li>
        </ol>
        <p>
          Điểm từ 90% trở lên là bài đã sẵn sàng đăng. Nếu còn bất kỳ mục <strong>Bắt buộc</strong> nào chưa đạt, công cụ vẫn xếp
          “Chưa nên đăng” dù tỷ lệ điểm cao, vì đó là những lỗi khiến bài khó lên top nhất. Bấm vào từng mục để xem vì sao mục đó quan
          trọng và cách sửa cụ thể, rồi chấm lại sau khi chỉnh. Bạn có thể sao chép báo cáo để gửi cho người viết, hoặc in ra PDF để lưu.
        </p>

        <h2>Câu hỏi thường gặp</h2>
        <details>
          <summary>Công cụ có lưu bài viết của tôi không?</summary>
          <p>Không. Ở chế độ dán nội dung, toàn bộ việc chấm diễn ra ngay trên trình duyệt của bạn. Ở chế độ URL, máy chủ chỉ tải trang giúp bạn rồi trả kết quả, không lưu URL hay nội dung.</p>
        </details>
        <details>
          <summary>Vì sao có mục phải tự tick?</summary>
          <p>Một số tiêu chí cần hiểu nội dung như người đọc (đúng ý định tìm kiếm, có giá trị riêng) hoặc cần dữ liệu ngoài bài (Search Console, bài cũ đã link về). Công cụ hiển thị hướng dẫn để bạn tự kiểm tra nhanh rồi tick.</p>
        </details>
        <details>
          <summary>Đạt 100% có chắc chắn lên top Google không?</summary>
          <p>Không có công cụ nào bảo đảm thứ hạng. Checklist giúp bài không mắc lỗi on-page và đáp ứng đúng khuyến nghị của Google; thứ hạng còn phụ thuộc mức cạnh tranh, độ uy tín của website và liên kết từ bên ngoài.</p>
        </details>
        <details>
          <summary>Dán từ Google Docs có giữ được heading không?</summary>
          <p>Có. Hãy dùng kiểu Tiêu đề 1, 2, 3 (Heading 1, 2, 3) trong Google Docs; khi dán, công cụ nhận đúng H1/H2/H3, danh sách, link và ảnh.</p>
        </details>
      </section>
    </section>
  </article>
</BaseLayout>

<script>
  import { analyze, score, sanitizeHtml, textToHtml, CHECKLIST, type CheckResult, type PageMeta, type UrlExtras } from '../../lib/seo-checker';
  import { absUrl } from '../../lib/seo-checker/rules-url';
  import { contentRoot, linkKind, hostOf } from '../../lib/seo-checker/extract';
  import { T } from '../../lib/seo-checker/strings';
  import { charLength } from '../../lib/seo-checker/text';

  const form = document.getElementById('sc-form') as HTMLFormElement;
  const editor = document.getElementById('sc-editor') as HTMLDivElement;
  const htmlBox = document.getElementById('sc-html') as HTMLTextAreaElement;
  const out = document.getElementById('sc-result') as HTMLDivElement;
  const err = document.getElementById('sc-err') as HTMLParagraphElement;
  const EBOOK = '/tai-lieu/checklist-seo-on-page';
  let sub: 'rich' | 'html' = 'rich';
  let mode: 'paste' | 'url' = 'paste';
  let last: { results: CheckResult[]; meta: PageMeta; doc: Document; extras?: UrlExtras; loading?: string[] } | null = null;
  const ticked = new Set<number>();
  /** Trạng thái mở/đóng do người dùng chọn (giữ nguyên khi kết quả cập nhật thêm PageSpeed, link…) */
  const openState = new Map<number, boolean>();
  let run = 0; // chặn kết quả cũ ghi đè khi người dùng chấm lại

  // ---------- Chuyển chế độ Dán nội dung / Nhập URL ----------
  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
    b.addEventListener('click', () => {
      mode = b.dataset.mode as 'paste' | 'url';
      document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((x) => {
        x.classList.toggle('active', x === b);
        x.setAttribute('aria-selected', String(x === b));
      });
      document.querySelectorAll<HTMLElement>('[data-only]').forEach((el) => (el.hidden = el.dataset.only !== mode));
      err.hidden = true;
    }),
  );

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  // Markdown tối giản trong JSON: **đậm**, `mã`
  const md = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/`([^`]*)`/g, (_, c) => (c ? `<code>${c}</code>` : ''));

  // ---------- Dán từ Docs/Word: giữ cấu trúc, bỏ định dạng thừa ----------
  editor.addEventListener('paste', (e) => {
    e.preventDefault();
    const dt = e.clipboardData;
    if (!dt) return;
    const html = dt.getData('text/html');
    const clean = html ? sanitizeHtml(html) : textToHtml(dt.getData('text/plain'));
    document.execCommand('insertHTML', false, clean);
  });

  // ---------- Tab phụ: soạn thảo / dán HTML ----------
  document.querySelectorAll<HTMLButtonElement>('[data-sub]').forEach((b) =>
    b.addEventListener('click', () => {
      sub = b.dataset.sub as 'rich' | 'html';
      document.querySelectorAll('[data-sub]').forEach((x) => x.classList.toggle('active', x === b));
      editor.hidden = sub !== 'rich';
      htmlBox.hidden = sub !== 'html';
    }),
  );

  // ---------- Đếm ký tự title/meta ----------
  const counters: [string, number, number][] = [
    ['title', 30, 60],
    ['metaDescription', 120, 160],
  ];
  for (const [name, min, max] of counters) {
    const input = form.elements.namedItem(name) as HTMLInputElement;
    const badge = form.querySelector<HTMLElement>(`[data-count="${name}"]`)!;
    const upd = () => {
      const n = charLength(input.value.trim());
      badge.textContent = n ? `${n} ký tự` : '';
      badge.className = 'sc-count ' + (!n ? '' : n >= min && n <= max ? 'ok' : 'bad');
    };
    input.addEventListener('input', upd);
  }

  document.getElementById('sc-clear')!.addEventListener('click', () => {
    editor.innerHTML = '';
    htmlBox.value = '';
    out.hidden = true;
  });

  // ---------- Chấm ----------
  const showErr = (msg: string) => {
    err.hidden = !msg;
    err.textContent = msg;
  };
  const runBtn = form.querySelector<HTMLButtonElement>('.sc-run')!;
  const RUN_LABEL = runBtn.textContent!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (mode === 'url') return void checkUrl();
    const fd = new FormData(form);
    const meta: PageMeta = {
      keyword: String(fd.get('keyword') || '').trim(),
      title: String(fd.get('title') || '').trim(),
      metaDescription: String(fd.get('metaDescription') || '').trim(),
      url: String(fd.get('url') || '').trim(),
      domain: String(fd.get('domain') || '').trim(),
    };
    const html = sub === 'html' ? sanitizeHtml(htmlBox.value) : editor.innerHTML;
    const problem = !meta.keyword ? T.needKeyword : !html.replace(/<[^>]*>/g, '').trim() && !/<img/i.test(html) ? T.needContent : '';
    err.hidden = !problem;
    err.textContent = problem;
    if (problem) return;

    const doc = new DOMParser().parseFromString(`<!doctype html><html><body>${html}</body></html>`, 'text/html');
    run++;
    openState.clear();
    const results = analyze({ doc, meta, mode: 'paste' }, CHECKLIST);
    last = { results, meta, doc };
    render();
    out.hidden = false;
    out.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ---------- Chế độ URL: Worker tải trang → chấm trên trình duyệt → bổ sung PageSpeed, link, ảnh ----------
  async function api<T>(path: string, body: unknown): Promise<T> {
    let res: Response;
    try {
      res = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    } catch {
      throw new Error('Mất kết nối mạng, bạn thử lại nhé.');
    }
    const data = await res.json().catch(() => null);
    if (!data) throw new Error('Chế độ Nhập URL chưa chạy trên phiên bản web này. Hãy dùng chế độ “Dán nội dung”.');
    if (!res.ok) throw new Error(data.error || 'Không kiểm tra được URL này.');
    return data as T;
  }

  async function checkUrl() {
    const fd = new FormData(form);
    let pageUrl = String(fd.get('pageUrl') || '').trim();
    const keyword = String(fd.get('keyword') || '').trim();
    if (pageUrl && !/^https?:\/\//i.test(pageUrl)) pageUrl = 'https://' + pageUrl;
    if (!pageUrl) return showErr('Nhập URL bài viết cần kiểm tra.');
    if (!keyword) return showErr(T.needKeyword);
    showErr('');
    const my = ++run;
    runBtn.disabled = true;
    runBtn.textContent = 'Đang tải trang…';
    let page: { finalUrl: string; status: number; headers: Record<string, string>; html: string; truncated: boolean; robotsTxt: string | null; sitemapHasUrl: boolean };
    try {
      page = await api('/api/seo/fetch', { url: pageUrl });
    } catch (e) {
      runBtn.disabled = false;
      runBtn.textContent = RUN_LABEL;
      return showErr((e as Error).message);
    }
    runBtn.disabled = false;
    runBtn.textContent = RUN_LABEL;
    if (my !== run) return;

    const doc = new DOMParser().parseFromString(page.html, 'text/html');
    const meta: PageMeta = {
      keyword,
      title: (doc.querySelector('title')?.textContent || '').replace(/\s+/g, ' ').trim(),
      metaDescription: (doc.querySelector('meta[name="description"]')?.getAttribute('content') || '').trim(),
      url: page.finalUrl,
      domain: hostOf(page.finalUrl),
    };
    const extras: UrlExtras = {
      finalUrl: page.finalUrl,
      status: page.status,
      headers: page.headers,
      robotsTxt: page.robotsTxt,
      sitemapHasUrl: page.sitemapHasUrl,
    };
    openState.clear();
    last = { results: [], meta, doc, extras, loading: ['Đang đo tốc độ trang bằng PageSpeed (khoảng 10–30 giây)…', 'Đang kiểm tra link ngoài và dung lượng ảnh…'] };
    if (page.truncated) last.loading!.push('Trang lớn hơn 3 MB: công cụ chỉ đọc 3 MB đầu.');
    rescore();
    render();
    out.hidden = false;
    out.scrollIntoView({ behavior: 'smooth', block: 'start' });

    // Link ngoài (≤20), ảnh trong nội dung (≤20), og:image
    const root = contentRoot(doc, 'url');
    const links = [...new Set(Array.from(root.querySelectorAll('a[href]')).map((a) => a.getAttribute('href') || ''))]
      .filter((h) => linkKind(h, meta.domain) === 'external')
      .map((h) => absUrl(h, page.finalUrl))
      .filter((h) => /^https?:/.test(h))
      .slice(0, 20);
    const images = [...new Set(Array.from(root.querySelectorAll('img')).map((i) => i.getAttribute('src') || i.getAttribute('data-src') || ''))]
      .filter((s) => s && !s.startsWith('data:'))
      .map((s) => absUrl(s, page.finalUrl))
      .slice(0, 20);
    const og = doc.querySelector('meta[property="og:image"]')?.getAttribute('content');
    const done = (msg: string) => {
      if (my !== run || !last) return;
      last.loading = (last.loading || []).filter((m) => !m.startsWith(msg));
      rescore();
      render();
    };
    api<{ pagespeed: UrlExtras['pagespeed']; pagespeedError?: string }>('/api/seo/psi', { url: page.finalUrl })
      .then((r) => Object.assign(extras, { pagespeed: r.pagespeed, pagespeedError: r.pagespeedError ?? null }))
      .catch((e) => Object.assign(extras, { pagespeed: null, pagespeedError: (e as Error).message }))
      .finally(() => done('Đang đo tốc độ'));
    api<{ linkStatus: Record<string, number>; imageBytes: Record<string, number>; ogImageSize: UrlExtras['ogImageSize'] }>('/api/seo/links', {
      links,
      images,
      ogImage: og ? absUrl(og, page.finalUrl) : null,
    })
      .then((r) => Object.assign(extras, r))
      .catch(() => {})
      .finally(() => done('Đang kiểm tra link'));
  }

  /** Chấm lại toàn bộ với dữ liệu hiện có (rất nhanh, dùng khi có thêm PageSpeed/link) */
  function rescore() {
    if (!last) return;
    last.results = analyze({ doc: last.doc, meta: last.meta, mode: last.extras ? 'url' : 'paste', extras: last.extras }, CHECKLIST);
  }

  // ---------- Hiển thị ----------
  const ICON: Record<string, string> = { pass: '✓', warn: '!', fail: '✕', manual: '☐', na: '–' };
  const prioClass = (p: string) => (p === 'Bắt buộc' ? 'p3' : p === 'Quan trọng' ? 'p2' : 'p1');

  function summaryHtml() {
    const s = score(last!.results, CHECKLIST, ticked);
    const pct = Math.round(s.ratio * 100);
    const tone = s.blockedByMandatory || s.ratio < 0.6 ? 'fail' : s.ratio < 0.9 ? 'warn' : 'pass';
    const C = 2 * Math.PI * 52;
    const byId = new Map(CHECKLIST.items.map((i) => [i.id, i]));
    const urgent = s.urgent
      .map((id) => `<li><a href="#sc-item-${id}">#${id} ${esc(byId.get(id)!.title)}</a> <span>${esc(last!.results.find((r) => r.id === id)!.measured)}</span></li>`)
      .join('');
    return `
      <div class="sc-ring sc-${tone}">
        <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" class="bg"/><circle cx="60" cy="60" r="52" class="fg"
          stroke-dasharray="${(C * s.ratio).toFixed(1)} ${C.toFixed(1)}" transform="rotate(-90 60 60)"/></svg>
        <div><b>${pct}%</b><span>${s.earned.toLocaleString('vi-VN')}/${s.max} ${T.points}</span></div>
      </div>
      <div class="sc-sum-main">
        <p class="sc-rating sc-${tone}">${esc(s.rating)}</p>
        ${s.blockedByMandatory ? `<p class="sc-note">${T.blocked}</p>` : ''}
        <div class="sc-counts">
          <span class="c-pass">${ICON.pass} ${T.statusLabel.pass} <b>${s.counts.pass}</b></span>
          <span class="c-warn">${ICON.warn} ${T.statusLabel.warn} <b>${s.counts.warn}</b></span>
          <span class="c-fail">${ICON.fail} ${T.statusLabel.fail} <b>${s.counts.fail}</b></span>
          <span class="c-manual">${ICON.manual} ${T.statusLabel.manual} <b>${s.counts.manual}</b></span>
        </div>
        ${(last!.loading || []).map((m) => `<p class="sc-loading"><i></i>${esc(m)}</p>`).join('')}
        <div class="sc-urgent">
          <b>🔥 ${T.urgentTitle}</b>
          ${urgent ? `<ol>${urgent}</ol>` : `<p>${T.urgentEmpty}</p>`}
        </div>
      </div>`;
  }

  function previewHtml() {
    const m = last!.meta;
    const cut = (s: string, n: number) => (charLength(s) > n ? [...s].slice(0, n - 1).join('').trimEnd() + '…' : s);
    let host = m.domain.replace(/^https?:\/\//, '').replace(/\/.*$/, '') || 'tenmien.vn';
    let path = '';
    try {
      const u = new URL(/^https?:\/\//.test(m.url) ? m.url : `https://${host}/${m.url.replace(/^\/+/, '')}`);
      if (/^https?:\/\//.test(m.url) || m.url.includes('.')) host = u.hostname;
      path = u.pathname.split('/').filter(Boolean).join(' › ');
    } catch {}
    return `
      <p class="sc-sec-title">${T.previewTitle}</p>
      <div class="sc-serp">
        <div class="u"><span class="fav"></span><div><b>${esc(host)}</b><small>https://${esc(host)}${path ? ' › ' + esc(path) : ''}</small></div></div>
        <div class="t">${esc(m.title ? cut(m.title, 60) : T.previewEmptyTitle)}</div>
        <div class="d">${esc(m.metaDescription ? cut(m.metaDescription, 160) : T.previewEmptyMeta)}</div>
      </div>`;
  }

  function itemHtml(r: CheckResult) {
    const it = CHECKLIST.items.find((i) => i.id === r.id)!;
    const done = r.status === 'manual' && ticked.has(r.id);
    const open = openState.get(r.id) ?? (r.status === 'fail' || r.status === 'warn');
    const details = r.details.length ? `<ul class="sc-det">${r.details.map((d) => `<li>${esc(d)}</li>`).join('')}</ul>` : '';
    const manual =
      r.status === 'manual'
        ? `<div class="sc-manual">
            <label><input type="checkbox" data-tick="${r.id}" ${done ? 'checked' : ''}> ${T.manualChecked}</label>
            ${r.aiSoon ? `<span class="sc-ai">${T.aiSoon}</span>` : ''}
            ${r.manualReason ? `<p>${esc(r.manualReason)}</p>` : ''}
            ${(r.links || []).map((l) => `<a href="${esc(l.href)}" target="_blank" rel="noopener" class="sc-link">${esc(l.label)} ↗</a>`).join('')}
          </div>`
        : '';
    const ex = it.examples.length
      ? `<ul class="sc-ex">${it.examples.map((e) => `<li class="ex-${e.kind}"><span>${T.examples[e.kind]}</span>${md(e.text).replace(/\n/g, '<br>')}</li>`).join('')}</ul>`
      : '';
    const st = done ? 'done' : r.status;
    return `
      <div class="sc-item sc-st-${st}" id="sc-item-${r.id}">
        <button type="button" class="sc-item-head" aria-expanded="${open}">
          <i class="sc-ico">${done ? '✓' : ICON[r.status]}</i>
          <span class="sc-item-t"><b>${r.id}. ${esc(it.title)}</b>
            <small>${esc(r.measured || it.short)}</small></span>
          <span class="sc-prio ${prioClass(it.priority)}">${esc(it.priority)}</span>
          <span class="sc-stlabel">${done ? T.manualDone : T.statusLabel[r.status]}</span>
        </button>
        <div class="sc-item-body" ${open ? '' : 'hidden'}>
          ${details}${manual}
          <p class="sc-sub">${T.why}</p><p>${md(it.why)}</p>
          <p class="sc-sub">${T.how}</p><ul>${it.how.map((h) => `<li>${md(h)}</li>`).join('')}</ul>
          ${ex}
          ${it.tools ? `<p class="sc-tools"><b>${T.tools}:</b> ${md(it.tools)}</p>` : ''}
        </div>
      </div>`;
  }

  function render() {
    if (!last) return;
    const groups = CHECKLIST.groups
      .map((g) => {
        const items = last!.results.filter((r) => CHECKLIST.items.find((i) => i.id === r.id)!.group === g.key);
        return `<section class="sc-group">
          <h3><span>${g.key}</span>${esc(g.name)}</h3>
          <p class="sc-gintro">${esc(g.intro)}</p>
          ${items.map(itemHtml).join('')}
        </section>`;
      })
      .join('');
    out.innerHTML = `
      <div class="panel sc-summary" id="sc-summary">${summaryHtml()}</div>
      <div class="panel sc-preview">${previewHtml()}
        <div class="sc-tools-row">
          <button type="button" class="btn btn-ghost" id="sc-copy">${T.copy}</button>
          <button type="button" class="btn btn-ghost" id="sc-print">${T.print}</button>
        </div>
      </div>
      <div class="panel sc-list">${groups}</div>`;
  }

  // Mở/đóng mục, tick tự kiểm tra, sao chép, in — gắn 1 lần (event delegation)
  out.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const head = t.closest<HTMLButtonElement>('.sc-item-head');
    if (head) {
      const body = head.nextElementSibling as HTMLElement;
      body.hidden = !body.hidden;
      head.setAttribute('aria-expanded', String(!body.hidden));
      openState.set(Number(head.parentElement!.id.replace('sc-item-', '')), !body.hidden);
    }
    if (t.id === 'sc-print') window.print();
    if (t.id === 'sc-copy') {
      navigator.clipboard.writeText(reportText()).then(() => {
        t.textContent = T.copied;
        setTimeout(() => (t.textContent = T.copy), 2000);
      });
    }
  });
  out.addEventListener('change', (e) => {
    const box = (e.target as HTMLElement).closest<HTMLInputElement>('[data-tick]');
    if (!box) return;
    const id = Number(box.dataset.tick);
    box.checked ? ticked.add(id) : ticked.delete(id);
    // Cập nhật điểm ngay + trạng thái mục
    document.getElementById('sc-summary')!.innerHTML = summaryHtml();
    const item = document.getElementById(`sc-item-${id}`)!;
    item.className = `sc-item sc-st-${box.checked ? 'done' : 'manual'}`;
    item.querySelector('.sc-ico')!.textContent = box.checked ? '✓' : ICON.manual;
    item.querySelector('.sc-stlabel')!.textContent = box.checked ? T.manualDone : T.statusLabel.manual;
  });

  function reportText() {
    const s = score(last!.results, CHECKLIST, ticked);
    const lines = [
      T.reportTitle,
      `Từ khoá: ${last!.meta.keyword}`,
      ...(last!.extras ? [`URL: ${last!.extras.finalUrl}`] : []),
      `Điểm: ${Math.round(s.ratio * 100)}% (${s.earned}/${s.max}) · ${s.rating}`,
      `Đạt ${s.counts.pass} · Cần cải thiện ${s.counts.warn} · Chưa đạt ${s.counts.fail} · Tự kiểm tra ${s.counts.manual}`,
      '',
    ];
    for (const g of CHECKLIST.groups) {
      lines.push(`${g.key}. ${g.name.toUpperCase()}`);
      for (const r of last!.results) {
        const it = CHECKLIST.items.find((i) => i.id === r.id)!;
        if (it.group !== g.key) continue;
        const st = r.status === 'manual' && ticked.has(r.id) ? T.manualDone : T.statusLabel[r.status];
        lines.push(`[${st}] ${r.id}. ${it.title} (${it.priority})${r.measured ? ': ' + r.measured : ''}`);
        if (r.status === 'fail' || r.status === 'warn') r.details.forEach((d) => lines.push(`    - ${d}`));
      }
      lines.push('');
    }
    lines.push(`Xem giải thích chi tiết từng điểm: ${location.origin}${EBOOK}`);
    return lines.join('\n');
  }
</script>

