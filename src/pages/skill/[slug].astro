</style>

<script>
  // Bấm câu thử → copy vào clipboard, đổi nhãn tạm thời
  document.querySelectorAll<HTMLButtonElement>('.try').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy || '');
      } catch {
        return;
      }
      const tag = b.querySelector('.try-copy') as HTMLElement;
      const old = tag.textContent;
      tag.textContent = document.documentElement.lang === 'en' ? '✓ Copied' : '✓ Đã copy';
      setTimeout(() => (tag.textContent = old), 1500);
    })
  );
</script>
