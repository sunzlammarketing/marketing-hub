---
// Trang bán từng skill (/skill/<slug>) — phong cách noti.vn/skill: nền tối có quầng sáng,
// mỗi phần là một khối lớn (panel) với nhãn viên thuốc, tiêu đề có cụm chữ gradient,
// thẻ có nhãn màu riêng, danh sách icon ✓ ✕ ! ☆ +, ô "Phù hợp khi" nổi bật.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyButton from '../../components/BuyButton.astro';
import PaymentModal from '../../components/PaymentModal.astro';
import PromoBar from '../../components/PromoBar.astro';
import { SKILLS, type Skill } from '../../data/skills';
import { formatVnd, effectivePrice } from '../../data/products';

export function getStaticPaths() {
  return SKILLS.map((s) => ({ params: { slug: s.slug }, props: { skill: s } }));
}
const { skill: s } = Astro.props as { skill: Skill };
const ep = effectivePrice(s);
const off = ep.off;
const total = s.groups.reduce((n, g) => n + g.items.length, 0);
// Màu nhãn xoay vòng cho các thẻ
const ACCENTS = ['#f87171', '#60a5fa', '#a78bfa', '#fbbf24', '#34d399', '#f472b6', '#22d3ee', '#fb923c', '#818cf8', '#4ade80'];
const accent = (i: number) => ACCENTS[i % ACCENTS.length];
const pad2 = (n: number) => String(n).padStart(2, '0');
// Ví dụ kết quả: escape HTML rồi đổi **chữ** thành chữ đậm
const outputHtml = s.output
  .replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!)
  .replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: s.name.vi,
  description: s.desc.vi,
  brand: { '@type': 'Brand', name: 'Sunz Làm Marketing' },
  ...(ep.price != null && {
    offers: { '@type': 'Offer', price: ep.price, priceCurrency: 'VND', availability: 'https://schema.org/InStock' },
  }),
};
---

<BaseLayout title={s.name.vi} description={s.desc.vi}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="sk-page">
    <!-- HERO -->
    <section class="container sk-hero">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/" data-i18n="nav.home">Trang chủ</a> <span>/</span>
        <a href="/skill" data-i18n-vi="Skill AI" data-i18n-en="AI Skills">Skill AI</a>
      </nav>
      <span class="pill pill-green"><i class="live-dot"></i> <span data-i18n-vi="Đang mở bán" data-i18n-en="Now available">Đang mở bán</span></span>
      <h1 data-i18n-vi={s.name.vi} data-i18n-en={s.name.en}>{s.name.vi}</h1>
      <p class="sk-lead" data-i18n-vi={s.desc.vi} data-i18n-en={s.desc.en}>{s.desc.vi}</p>
      <div class="sk-compat">
        {s.platforms.map((pl) => (
          <a href="#nen-tang" class={`chip${pl.best ? ' chip-best' : ''}`}>{pl.best && '★ '}{pl.name}</a>
        ))}
      </div>

      <div class="sk-stats">
        {s.stats.map((st, i) => (
          <div class="sk-stat" style={`--a:${accent(i)}`}>
            <b>{st.value}</b>
            <span data-i18n-vi={st.label.vi} data-i18n-en={st.label.en}>{st.label.vi}</span>
          </div>
        ))}
      </div>

      <div class="sk-buy">
        <div class="sk-price">
          {ep.price != null ? (
            <span class="sk-pbox" data-price-box data-until={ep.promo?.until} data-regular={s.price != null ? formatVnd(s.price) : undefined}>
              {off && (
                <span class="sk-old" data-pold><s>{formatVnd(ep.old!)}</s> <b>-{off}%</b></span>
              )}
              {ep.promo && <span class="sk-plabel" data-pold data-i18n-vi="Giá mở bán" data-i18n-en="Launch price">Giá mở bán</span>}
              <span class="sk-now" data-pnow>{formatVnd(ep.price)}</span>
              {ep.promo && s.price != null && s.price > ep.price && (
                <span class="sk-reg" data-pold>
                  <span data-i18n-vi="Giá chính thức" data-i18n-en="Regular price">Giá chính thức</span>
                  <s>{formatVnd(s.price)}</s>
                  <b data-i18n-vi={`Tiết kiệm ${formatVnd(s.price - ep.price)}`} data-i18n-en={`Save ${formatVnd(s.price - ep.price)}`}>Tiết kiệm {formatVnd(s.price - ep.price)}</b>
                </span>
              )}
            </span>
          ) : (
            <span class="sk-now" data-i18n-vi="Liên hệ" data-i18n-en="Contact us">Liên hệ</span>
          )}
        </div>
        <BuyButton product={s} size="lg" />
        <a href="#so-sanh" class="sk-ghost" data-i18n-vi="Skill làm được gì? ↓" data-i18n-en="What does it do? ↓">Skill làm được gì? ↓</a>
      </div>
      {ep.promo && <PromoBar product={s} tone="auto" />}
    </section>

    <!-- SO SÁNH ✕ / ✓ -->
    <section class="container panel-wrap" id="so-sanh">
      <div class="panel">
        <span class="pill pill-red" data-i18n-vi="Vì sao nên dùng" data-i18n-en="Why use it">Vì sao nên dùng</span>
        <h2>
          <span data-i18n-vi="Viết caption kiểu cũ vs " data-i18n-en="The old way vs ">Viết caption kiểu cũ vs </span><span class="hl" data-i18n-vi="dùng skill Sunz" data-i18n-en="the Sunz skill">dùng skill Sunz</span>
        </h2>
        <div class="cmp">
          <div class="card card-dim">
            <span class="tag" style="--a:#f87171">{s.compare.without.title}</span>
            <ul class="ic-list">
              {s.compare.without.no.map((t) => <li><i class="ic ic-no">✕</i>{t}</li>)}
              {s.compare.without.warn.map((t) => <li><i class="ic ic-warn">!</i>{t}</li>)}
            </ul>
            <p class="fit"><b>Phù hợp khi:</b> {s.compare.without.fit}</p>
          </div>
          <div class="card card-glow">
            <span class="tag" style="--a:#34d399">{s.compare.with.title}</span>
            <ul class="ic-list">
              {s.compare.with.ok.map((t) => <li><i class="ic ic-ok">✓</i>{t}</li>)}
              {s.compare.with.star.map((t) => <li><i class="ic ic-star">☆</i>{t}</li>)}
            </ul>
            <p class="fit fit-glow"><b>Phù hợp khi:</b> {s.compare.with.fit}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TÌNH HUỐNG -->
    <section class="container panel-wrap" id="tinh-huong">
      <div class="panel">
        <span class="pill pill-blue" data-i18n-vi="Bắt đầu từ vấn đề" data-i18n-en="Start from the problem">Bắt đầu từ vấn đề</span>
        <h2>
          <span data-i18n-vi="Bạn đang gặp " data-i18n-en="Which ">Bạn đang gặp </span><span class="hl" data-i18n-vi="tình huống nào?" data-i18n-en="situation are you in?">tình huống nào?</span>
        </h2>
        <p class="sub">Chỉ cần mô tả vấn đề, skill tự tra bảng và chọn công thức phù hợp. 8 tình huống chính:</p>
        <div class="grid-4">
          {s.situations.map((x, i) => (
            <div class="card">
              <span class="tag" style={`--a:${accent(i)}`}>Tình huống {pad2(i + 1)}</span>
              <h3>{x.problem}</h3>
              <ul class="ic-list ic-sm">
                {x.picks.map((p) => <li><i class="ic ic-plus">+</i>Mẫu {p}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- QUY TRÌNH -->
    <section class="container panel-wrap">
      <div class="panel">
        <span class="pill pill-purple" data-i18n-vi="Quy trình bắt buộc" data-i18n-en="Built-in workflow">Quy trình bắt buộc</span>
        <h2>
          <span class="hl">{s.steps.length} bước</span> <span data-i18n-vi="AI làm mỗi lần bạn nhờ" data-i18n-en="the AI follows every time">AI làm mỗi lần bạn nhờ</span>
        </h2>
        <p class="sub">Không viết bừa: đi đúng thứ tự từ hiểu vấn đề đến soát lỗi.</p>
        <ol class="steps">
          {s.steps.map((st, i) => (
            <li class="card">
              <span class="tag" style={`--a:${accent(i + 1)}`}>Bước {pad2(i + 1)}</span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- THƯ VIỆN CÔNG THỨC -->
    <section class="container panel-wrap">
      <div class="panel">
        <span class="pill pill-amber" data-i18n-vi="Thư viện công thức" data-i18n-en="Formula library">Thư viện công thức</span>
        <h2>
          <span class="hl">{total} công thức viết content</span>, <span>{s.groups.length} nhóm mục tiêu</span>
        </h2>
        <p class="sub">Mỗi công thức có: khi nào dùng, khung viết chi tiết, kênh phù hợp và lưu ý để không viết sai.</p>
        <div class="grid-5">
          {s.groups.map((g, gi) => (
            <div class="card">
              <span class="tag" style={`--a:${accent(gi)}`}>Nhóm {g.code} · {pad2(gi * 5 + 1)}–{pad2(gi * 5 + g.items.length)}</span>
              <h3>{g.name}</h3>
              <ul class="ic-list ic-sm">
                {g.items.map((it) => <li><i class="ic ic-plus">+</i>{it}</li>)}
              </ul>
              <p class="fit"><b>Dùng khi:</b> {g.goal.toLowerCase()}.</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PHÁP LÝ + KẾT QUẢ -->
    <section class="container panel-wrap">
      <div class="panel two-col">
        <div>
          <span class="pill pill-green" data-i18n-vi="An toàn khi đăng" data-i18n-en="Safe to publish">An toàn khi đăng</span>
          <h2>
            <span data-i18n-vi="Tự soát " data-i18n-en="Checks ">Tự soát </span><span class="hl">{s.legal.length} điểm pháp lý</span>
          </h2>
          <ul class="ic-list">
            {s.legal.map((l) => <li><i class="ic ic-ok">✓</i>{l}</li>)}
            <li class="muted"><i class="ic ic-warn">!</i>Phần soát pháp lý là gợi ý tham khảo, không thay thế tư vấn pháp lý.</li>
          </ul>
        </div>
        <div>
          <span class="pill pill-blue" data-i18n-vi="Kết quả trả về" data-i18n-en="What you get back">Kết quả trả về</span>
          <h2>
            <span class="hl">2-3 phiên bản</span> <span data-i18n-vi="sẵn sàng A/B test" data-i18n-en="ready to A/B test">sẵn sàng A/B test</span>
          </h2>
          <pre class="out"><code set:html={outputHtml} /></pre>
        </div>
      </div>
    </section>

    <!-- NỀN TẢNG -->
    <section class="container panel-wrap" id="nen-tang">
      <div class="panel">
        <span class="pill pill-purple" data-i18n-vi="Dùng trên nền tảng nào?" data-i18n-en="Which platforms?">Dùng trên nền tảng nào?</span>
        <h2>
          <span data-i18n-vi="Mua một lần, " data-i18n-en="Buy once, ">Mua một lần, </span><span class="hl" data-i18n-vi="dùng trên 4 nền tảng AI" data-i18n-en="use on 4 AI platforms">dùng trên 4 nền tảng AI</span>
        </h2>
        <p class="sub">Skill viết theo chuẩn mở Agent Skills (file SKILL.md). {s.compat}.</p>
        <div class="grid-4">
          {s.platforms.map((pl, i) => (
            <div class={`card${pl.best ? ' card-glow' : ''}`}>
              <div class="plat-head">
                <span class="tag" style={`--a:${pl.best ? '#a78bfa' : accent(i + 1)}`}>{pl.best ? '★ ' : ''}{pl.badge}</span>
              </div>
              <h3>{pl.name}</h3>
              <ol class="num-list">
                {pl.steps.map((st) => <li>{st}</li>)}
              </ol>
              {pl.note && (
                <p class={`fit${pl.best ? ' fit-glow' : ''}`}>
                  <i class={`ic ${pl.best ? 'ic-star' : pl.warn ? 'ic-warn' : 'ic-ok'}`}>{pl.best ? '☆' : pl.warn ? '!' : '✓'}</i> {pl.note}
                </p>
              )}
            </div>
          ))}
        </div>
        <p class="updated">ℹ️ {s.updated}</p>
      </div>
    </section>

    <!-- THỬ NGAY -->
    <section class="container panel-wrap">
      <div class="panel">
        <span class="pill pill-red" data-i18n-vi="Dùng thử ngay" data-i18n-en="Try it now">Dùng thử ngay</span>
        <h2>
          <span data-i18n-vi="Chỉ cần mô tả tình huống " data-i18n-en="Just describe your situation ">Chỉ cần mô tả tình huống </span><span class="hl" data-i18n-vi="như nói chuyện" data-i18n-en="in plain words">như nói chuyện</span>
        </h2>
        <div class="grid-4">
          {s.tryPrompts.map((t, i) => (
            <button type="button" class="card try" data-copy={t.text}>
              <span class="tag" style={`--a:${accent(i)}`}>{t.label}</span>
              <span class="try-text">“{t.text}”</span>
              <span class="try-copy" data-i18n-vi="Bấm để copy" data-i18n-en="Click to copy">Bấm để copy</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- GÓI NHẬN ĐƯỢC + CTA -->
    <section class="container panel-wrap panel-last">
      <div class="panel two-col final">
        <div>
          <span class="pill pill-green" data-i18n-vi="Bạn nhận được" data-i18n-en="You receive">Bạn nhận được</span>
          <ul class="ic-list">
            {s.includes.map((x) => <li><i class="ic ic-ok">✓</i>{x}</li>)}
          </ul>
          <span class="pill pill-amber" data-i18n-vi="Yêu cầu" data-i18n-en="Requirements">Yêu cầu</span>
          <ul class="ic-list">
            {s.requires.map((x) => <li><i class="ic ic-plus">+</i>{x}</li>)}
          </ul>
        </div>
        <div class="buy-card">
          <b class="buy-name" data-i18n-vi={s.name.vi} data-i18n-en={s.name.en}>{s.name.vi}</b>
          <div class="sk-price">
            {ep.price != null ? (
              <span class="sk-pbox" data-price-box data-until={ep.promo?.until} data-regular={s.price != null ? formatVnd(s.price) : undefined}>
                {off && (
                  <span class="sk-old" data-pold><s>{formatVnd(ep.old!)}</s> <b>-{off}%</b></span>
                )}
                {ep.promo && <span class="sk-plabel" data-pold data-i18n-vi="Giá mở bán" data-i18n-en="Launch price">Giá mở bán</span>}
              <span class="sk-now" data-pnow>{formatVnd(ep.price)}</span>
              {ep.promo && s.price != null && s.price > ep.price && (
                <span class="sk-reg" data-pold>
                  <span data-i18n-vi="Giá chính thức" data-i18n-en="Regular price">Giá chính thức</span>
                  <s>{formatVnd(s.price)}</s>
                  <b data-i18n-vi={`Tiết kiệm ${formatVnd(s.price - ep.price)}`} data-i18n-en={`Save ${formatVnd(s.price - ep.price)}`}>Tiết kiệm {formatVnd(s.price - ep.price)}</b>
                </span>
              )}
              </span>
            ) : (
              <span class="sk-now" data-i18n-vi="Liên hệ" data-i18n-en="Contact us">Liên hệ</span>
            )}
          </div>
          {ep.promo && <PromoBar product={s} tone="auto" />}
          <BuyButton product={s} size="lg" />
          <p class="buy-note" data-i18n-vi="Thanh toán chuyển khoản QR, nhận link tải skill qua email." data-i18n-en="Pay by QR bank transfer, get the download link by email.">
            Thanh toán chuyển khoản QR, nhận link tải skill qua email.
          </p>
        </div>
      </div>
    </section>
  </div>

  <PaymentModal />
</BaseLayout>

<style>
  /* ===== Nền tối toàn trang, quầng sáng màu (giống noti.vn) ===== */
  /* Bộ màu SÁNG (mặc định) — theo giao diện sáng noti.vn: nền trắng ngà, quầng pastel, thẻ trắng */
  .sk-page {
    --pg: #f8fafc;
    --g1: rgba(96, 165, 250, 0.35);
    --g2: rgba(253, 164, 175, 0.32);
    --g3: rgba(196, 181, 253, 0.35);
    --g4: rgba(125, 211, 252, 0.35);
    --dot: rgba(100, 116, 139, 0.12);
    --h: #0f172a;
    --ink-d: #1e293b;
    --body: #475569;
    --muted-d: #64748b;
    --line-d: rgba(15, 23, 42, 0.08);
    --panel: rgba(255, 255, 255, 0.72);
    --panel-shadow: 0 24px 50px -30px rgba(15, 23, 42, 0.25);
    --card: #ffffff;
    --card-hover: rgba(15, 23, 42, 0.16);
    --card-dim: linear-gradient(180deg, #fff1f2, #ffffff);
    --card-glow: linear-gradient(180deg, #f5f3ff, #ffffff);
    --glow-border: rgba(139, 92, 246, 0.45);
    --glow-shadow: 0 20px 50px -28px rgba(139, 92, 246, 0.55);
    --fit: #f1f5f9;
    --fit-glow: #ede9fe;
    --chip: #fff;
    --hl: linear-gradient(90deg, #0061ff, #2563eb 45%, #7c3aed);
    --tag-mix: #000 28%;
    --ok: #059669;
    --no: #dc2626;
    --warn: #d97706;
    --star: #7c3aed;
    --code-bg: #0f172a;
    position: relative;
    color: var(--ink-d);
    background:
      radial-gradient(900px 600px at 6% 12%, var(--g1), transparent 60%),
      radial-gradient(800px 600px at 18% 40%, var(--g2), transparent 60%),
      radial-gradient(900px 700px at 95% 35%, var(--g4), transparent 60%),
      radial-gradient(800px 600px at 70% 80%, var(--g3), transparent 60%),
      var(--pg);
    overflow: hidden;
    padding-bottom: 8px;
  }
  /* Bộ màu TỐI */
  :global([data-theme='dark']) .sk-page {
    --pg: #070b1a;
    --g1: rgba(239, 68, 68, 0.22);
    --g2: rgba(139, 92, 246, 0.2);
    --g3: rgba(255, 119, 89, 0.16);
    --g4: rgba(59, 130, 246, 0.22);
    --dot: rgba(148, 163, 184, 0.12);
    --h: #fff;
    --ink-d: #e2e8f0;
    --body: #cbd5e1;
    --muted-d: #94a3b8;
    --line-d: rgba(148, 163, 184, 0.16);
    --panel: linear-gradient(180deg, rgba(30, 41, 82, 0.55), rgba(15, 23, 42, 0.62));
    --panel-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    --card: linear-gradient(180deg, rgba(51, 65, 85, 0.42), rgba(30, 41, 59, 0.35));
    --card-hover: rgba(148, 163, 184, 0.32);
    --card-dim: linear-gradient(180deg, rgba(69, 26, 26, 0.35), rgba(30, 41, 59, 0.35));
    --card-glow: linear-gradient(180deg, rgba(76, 29, 149, 0.35), rgba(30, 41, 82, 0.45));
    --glow-border: rgba(167, 139, 250, 0.55);
    --glow-shadow: 0 20px 50px -24px rgba(139, 92, 246, 0.65);
    --fit: rgba(148, 163, 184, 0.1);
    --fit-glow: rgba(139, 92, 246, 0.16);
    --chip: rgba(148, 163, 184, 0.08);
    --hl: linear-gradient(90deg, #60a5fa, #38bdf8 45%, #a78bfa);
    --tag-mix: transparent 0%;
    --ok: #34d399;
    --no: #f87171;
    --warn: #fbbf24;
    --star: #a78bfa;
    --code-bg: rgba(2, 6, 23, 0.75);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sk-page {
      --pg: #070b1a;
      --g1: rgba(239, 68, 68, 0.22);
      --g2: rgba(139, 92, 246, 0.2);
      --g3: rgba(255, 119, 89, 0.16);
      --g4: rgba(59, 130, 246, 0.22);
      --dot: rgba(148, 163, 184, 0.12);
      --h: #fff;
      --ink-d: #e2e8f0;
      --body: #cbd5e1;
      --muted-d: #94a3b8;
      --line-d: rgba(148, 163, 184, 0.16);
      --panel: linear-gradient(180deg, rgba(30, 41, 82, 0.55), rgba(15, 23, 42, 0.62));
      --panel-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      --card: linear-gradient(180deg, rgba(51, 65, 85, 0.42), rgba(30, 41, 59, 0.35));
      --card-hover: rgba(148, 163, 184, 0.32);
      --card-dim: linear-gradient(180deg, rgba(69, 26, 26, 0.35), rgba(30, 41, 59, 0.35));
      --card-glow: linear-gradient(180deg, rgba(76, 29, 149, 0.35), rgba(30, 41, 82, 0.45));
      --glow-border: rgba(167, 139, 250, 0.55);
      --glow-shadow: 0 20px 50px -24px rgba(139, 92, 246, 0.65);
      --fit: rgba(148, 163, 184, 0.1);
      --fit-glow: rgba(139, 92, 246, 0.16);
