---
// Trang Giới thiệu — bố cục tham khảo noti.vn/about:
// hero → (thẻ hồ sơ dính bên trái | các thẻ nội dung bên phải) → lưới bài viết nổi bật.
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SOCIALS } from '../data/social';
import { getCollection } from 'astro:content';

// Ảnh đại diện: bỏ ảnh vào public/ rồi điền đường dẫn, ví dụ '/sunz-avatar.jpg'.
// Để trống thì hiện khối chữ "S" theo màu thương hiệu.
const AVATAR = '/logo-full.png';
const EMAIL = 'sunzlammarketing@gmail.com';
const SITE = 'https://marketing-hub-flax.vercel.app';

const links = [
  ...SOCIALS.map((s) => ({ label: s.name, value: s.handle, href: s.url, icon: s.icon, color: s.color })),
  {
    label: 'Email',
    value: EMAIL,
    href: `mailto:${EMAIL}`,
    icon: 'M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4.24-8 5-8-5V6l8 5 8-5v2.24Z',
    color: '#ea4335',
  },
];

const values = [
  { k: 'about.val1', icon: '🎯', title: 'Thực chiến, không lý thuyết suông', text: 'Mọi bài viết đều hướng tới việc áp dụng được ngay, kèm ví dụ và bước làm cụ thể.' },
  { k: 'about.val2', icon: '🇻🇳', title: 'Dành cho người Việt', text: 'Nội dung viết bằng tiếng Việt, phù hợp với bối cảnh thị trường và nền tảng người Việt hay dùng.' },
  { k: 'about.val3', icon: '🆓', title: 'Miễn phí & dễ tiếp cận', text: 'Kiến thức nên được chia sẻ. Toàn bộ nội dung trên Sunz Làm Marketing đều miễn phí.' },
  { k: 'about.val4', icon: '📈', title: 'Cập nhật liên tục', text: 'Marketing thay đổi từng ngày. Chúng tôi cập nhật kiến thức mới để bạn không tụt lại.' },
];

const resources = [
  { k: 'about.res.logo', label: 'Logo Sunz', copy: `${SITE}/logo-full.png`, preview: 'logo' },
  { k: 'about.res.web', label: 'Website', copy: SITE, preview: 'web' },
  { k: 'about.res.email', label: 'Email hợp tác', copy: EMAIL, preview: 'mail' },
];

const all = await getCollection('blog');
const pick = (l: 'vi' | 'en') =>
  all
    .filter((p) => p.data.lang === l)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 6);
const posts = [...pick('vi'), ...pick('en')];
const viCount = all.filter((p) => p.data.lang === 'vi').length;
---

<BaseLayout
  title="Giới thiệu"
  description="Sunz Làm Marketing là nơi chia sẻ kiến thức Marketing thực chiến, dễ hiểu và miễn phí cho người Việt."
>
  <section class="page-head ab-hero">
    <div class="container">
      <h1><span data-i18n-vi="Về" data-i18n-en="About">Về</span> <span class="hl">Sunz Làm Marketing</span></h1>
      <p data-i18n="home.me.bio">Chia sẻ kiến thức, tài liệu & công cụ Marketing miễn phí</p>
    </div>
  </section>

  <section class="container ab-grid">
    <!-- Cột trái: thẻ hồ sơ -->
    <aside class="ab-profile">
      <div class="ab-photo">
        {AVATAR ? <img src={AVATAR} alt="Sunz Làm Marketing" /> : <span>S</span>}
      </div>
      <h2 class="ab-name">Sunz Làm Marketing</h2>
      <p class="ab-role">@sunzlammarketing</p>
      <div class="ab-links">
        {links.map((l) => (
          <a
            href={l.href}
            class="ab-link"
            style={`--c:${l.color}`}
            {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <span class="ab-link-ico">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={l.icon} fill="currentColor" /></svg>
            </span>
            <span class="ab-link-text">
              <b>{l.label}</b>
              <small>{l.value}</small>
            </span>
          </a>
        ))}
      </div>
      <div class="ab-stat">
        <b>{viCount}+</b>
        <span data-i18n="about.stat">bài viết miễn phí</span>
      </div>
    </aside>

    <!-- Cột phải: nội dung -->
    <div class="ab-main">
      <div class="ab-card">
        <div class="ab-card-head">
          <span class="ab-label" data-i18n="about.short.label">Giới thiệu ngắn gọn</span>
          <button type="button" class="ab-copy" data-copy-target="#ab-short">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /></svg>
            <span data-i18n="about.short.copy">Copy giới thiệu</span>
          </button>
        </div>
        <p id="ab-short" class="ab-text" data-i18n="about.short.text">
          Sunz Làm Marketing là nơi chia sẻ kiến thức, tài liệu và công cụ Marketing thực chiến cho người Việt — sắp xếp có
          hệ thống từ căn bản đến nâng cao, kèm ví dụ thực tế và hoàn toàn miễn phí.
        </p>
      </div>

      <div class="ab-card ab-principle">
        <span class="ab-label" data-i18n="about.principle.label">Nguyên tắc</span>
        <p class="ab-strong" data-i18n="home.me.p3">
          Mình không hứa hẹn "làm giàu sau một đêm". Chỉ có kiến thức nền tảng vững chắc, ví dụ thực tế, và những thứ bạn
          áp dụng được ngay vào công việc của mình.
        </p>
      </div>

      <div class="ab-values">
        {values.map((v) => (
          <div class="ab-card ab-value">
            <h3><span>{v.icon}</span> <span data-i18n={`${v.k}.title`}>{v.title}</span></h3>
            <p data-i18n={`${v.k}.text`}>{v.text}</p>
          </div>
        ))}
      </div>

      <div class="ab-card">
        <span class="ab-label" data-i18n="about.story.title">Câu chuyện của chúng tôi</span>
        <p class="ab-text" data-i18n="about.story.p1">
          Có quá nhiều kiến thức marketing ngoài kia, nhưng phần lớn hoặc quá hàn lâm, hoặc chỉ là những "mẹo" rời rạc
          thiếu nền tảng. Người mới bắt đầu thường bối rối không biết học từ đâu.
        </p>
        <blockquote data-i18n="about.story.quote">
          "Marketing không phải là nghệ thuật bán thứ bạn làm ra, mà là nghệ thuật tạo ra thứ khách hàng thật sự cần."
        </blockquote>
        <div class="ab-cta">
          <a href="/blog" class="btn btn-primary" data-i18n="about.story.cta1">Khám phá bài viết →</a>
          <a href="/lien-he" class="btn btn-ghost" data-i18n="about.story.cta2">Liên hệ với chúng tôi</a>
        </div>
      </div>

      <div>
        <span class="ab-label ab-section-label" data-i18n="about.res.title">Tài nguyên thương hiệu, bấm để copy link</span>
        <div class="ab-res">
          {resources.map((r) => (
            <button type="button" class="ab-res-item" data-copy={r.copy}>
              <span class={`ab-res-prev prev-${r.preview}`}>
                {r.preview === 'logo' ? <img src="/logo-mark.png" alt="" width="56" height="56" /> : r.preview === 'web' ? '🌐' : '✉️'}
              </span>
              <b data-i18n={r.k}>{r.label}</b>
              <small data-i18n="about.res.copy">Copy link</small>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container ab-posts">
    <span class="ab-label ab-section-label" data-i18n="about.posts.title">Bài viết mới nhất</span>
    <div class="ab-post-grid">
      {posts.map((p) => (
        <PostCard
          slug={p.slug}
          title={p.data.title}
          description={p.data.description}
          pubDate={p.data.pubDate}
          category={p.data.category}
          readingTime={p.data.readingTime}
          lang={p.data.lang}
        />
      ))}
    </div>
  </section>

  <div class="ab-toast" role="status" aria-live="polite"></div>
</BaseLayout>

<style>

  .ab-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 28px;
    align-items: start;
    padding-bottom: var(--space-section);
  }

  /* Thẻ hồ sơ */
  .ab-profile {
    position: sticky;
    top: 90px;
    padding: 22px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    box-shadow: var(--shadow);
  }
  .ab-photo {
    aspect-ratio: 1;
    border-radius: 14px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 75% 20%, rgba(255, 255, 255, 0.28), transparent 45%),
      linear-gradient(135deg, var(--brand), var(--accent));
  }
  .ab-photo:has(img) {
    background: #fff;
    border: 1px solid var(--border);
  }
  .ab-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12%;
  }
  .ab-photo span {
    color: #fff;
    font-size: 7rem;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
  }
  .ab-name {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 18px 0 2px;
  }
  .ab-role {
    color: var(--ink-faint);
    font-size: 0.9rem;
    margin: 0 0 18px;
  }
  .ab-links {
    display: grid;
    gap: 6px;
  }
  .ab-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border-radius: 12px;
    color: var(--ink);
    transition: background 0.15s;
  }
  .ab-link:hover {
    background: var(--bg-soft);
    text-decoration: none;
  }
  .ab-link-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 14%, transparent);
  }
  :global([data-theme='dark']) .ab-link[style*='#000000'] .ab-link-ico {
    color: #fff;
  }
  .ab-link-text {
    min-width: 0;
    display: grid;
  }
  .ab-link-text b {
    font-size: 0.92rem;
  }
  .ab-link-text small {
    color: var(--ink-faint);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ab-stat {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .ab-stat b {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--brand);
  }
  .ab-stat span {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  /* Cột nội dung */
  .ab-main {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .ab-card {
    padding: 24px 26px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--panel);
    box-shadow: var(--panel-shadow);
    backdrop-filter: blur(8px);
  }
  .ab-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ab-label {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .ab-section-label {
    display: block;
    margin-bottom: 12px;
  }
  .ab-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--brand);
    background: var(--brand-soft);
    border: 0;
    border-radius: 999px;
    padding: 7px 14px;
    cursor: pointer;
  }
  .ab-copy:hover {
    filter: brightness(0.96);
  }
  .ab-text {
    color: var(--ink-soft);
    line-height: 1.75;
    margin: 12px 0 0;
  }
  .ab-principle {
    border-color: color-mix(in srgb, var(--brand) 35%, var(--border));
    background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 10%, var(--bg-card)), var(--bg-card));
  }
  .ab-principle .ab-label {
    color: var(--brand);
  }
  .ab-strong {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.7;
    color: var(--ink);
    margin: 10px 0 0;
  }
  .ab-values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .ab-value h3 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .ab-value p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
  }
  .ab-card blockquote {
    margin: 16px 0 0;
    padding: 12px 16px;
    border-left: 3px solid var(--brand);
    background: var(--bg-soft);
    border-radius: 0 10px 10px 0;
    font-style: italic;
    color: var(--ink);
  }
  .ab-cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  /* Tài nguyên thương hiệu */
  .ab-res {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .ab-res-item {
    display: grid;
    gap: 4px;
    justify-items: start;
    text-align: left;
    font: inherit;
    color: var(--ink);
    padding: 12px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    cursor: pointer;
    transition: border-color 0.15s, transform 0.15s;
  }
  .ab-res-item:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
  }
  .ab-res-prev {
    width: 100%;
    height: 92px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: 2rem;
    background: var(--bg-soft);
    margin-bottom: 6px;
  }
  .ab-res-item b {
    font-size: 0.9rem;
  }
  .ab-res-item small {
    color: var(--brand);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .ab-posts {
    padding-bottom: var(--space-section);
  }
  .ab-post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .ab-toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 95;
    transform: translate(-50%, 20px);
    opacity: 0;
    pointer-events: none;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.9rem;
    font-weight: 600;
    transition: 0.2s;
  }
  .ab-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 900px) {
    .ab-grid {
      grid-template-columns: 1fr;
    }
    .ab-profile {
      position: static;
      display: grid;
      grid-template-columns: 120px 1fr;
      column-gap: 18px;
      align-items: start;
    }
    .ab-photo {
      grid-row: span 2;
    }
    .ab-photo span {
      font-size: 3.4rem;
    }
    .ab-name {
      margin-top: 4px;
    }
    .ab-links,
    .ab-stat {
      grid-column: 1 / -1;
    }
    .ab-links {
      grid-template-columns: 1fr 1fr;
      margin-top: 14px;
    }
    .ab-post-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .ab-values,
    .ab-links,
    .ab-post-grid {
      grid-template-columns: 1fr;
    }
    .ab-res {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
    }
    .ab-res-prev {
      height: 64px;
    }
    .ab-card {
      padding: 18px;
    }
  }
</style>

<script>
  const toast = document.querySelector('.ab-toast') as HTMLElement | null;
  const t = (key: string, fallback: string) => {
    const dict = (window as any).__I18N__ || {};
    const l = document.documentElement.getAttribute('lang') === 'en' ? 'en' : 'vi';
    return (dict[l] && dict[l][key]) || fallback;
  };
  let timer: number | undefined;
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.append(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    if (!toast) return;
    toast.textContent = '✓ ' + t('about.copied', 'Đã copy');
    toast.classList.add('show');
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove('show'), 1600);
  }
  document.querySelectorAll<HTMLElement>('[data-copy-target]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const el = document.querySelector(btn.dataset.copyTarget!);
      if (el) copy(el.textContent!.trim().replace(/\s+/g, ' '));
    })
  );
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', () => copy(btn.dataset.copy!))
  );
</script>
