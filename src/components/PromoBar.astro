---
// Thanh ưu đãi có hạn: đếm ngược + thanh tiến độ thời gian (from → until) + giá sau ưu đãi.
// Hết hạn thì tự ẩn (xem PromoClock.astro). Dùng cho sản phẩm có `promo`.
import { formatVnd, type Product } from '../data/products';
interface Props {
  product: Product;
  tone?: 'dark' | 'light';
}
const { product: p, tone = 'light' } = Astro.props;
const promo = p.promo!;
const end = new Date(promo.until);
// Ngày hết hạn theo giờ VN
const endLabel = end.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', timeZone: 'Asia/Ho_Chi_Minh' });
const nextDay = new Date(end.getTime() + 1000).toLocaleDateString('vi-VN', {
  day: '2-digit',
  month: '2-digit',
  timeZone: 'Asia/Ho_Chi_Minh',
});
---

<div class={`promo promo-${tone}`} data-promo-bar data-from={promo.from} data-until={promo.until}>
  <div class="promo-top">
    <span class="promo-title">
      ⏰ <span data-i18n-vi={`Giá ưu đãi ${formatVnd(promo.price)} đến hết ${endLabel}`} data-i18n-en={`Special price ${formatVnd(promo.price)} until ${endLabel}`}>Giá ưu đãi {formatVnd(promo.price)} đến hết {endLabel}</span>
    </span>
    <span class="promo-clock" aria-live="off">
      <span><b data-cd="d">--</b><small data-i18n-vi="ngày" data-i18n-en="days">ngày</small></span>
      <span><b data-cd="h">--</b><small data-i18n-vi="giờ" data-i18n-en="hrs">giờ</small></span>
      <span><b data-cd="m">--</b><small data-i18n-vi="phút" data-i18n-en="min">phút</small></span>
      <span><b data-cd="s">--</b><small data-i18n-vi="giây" data-i18n-en="sec">giây</small></span>
    </span>
  </div>
  <div class="promo-track" role="progressbar" aria-label="Thời gian ưu đãi đã trôi qua" aria-valuemin="0" aria-valuemax="100">
    <div class="promo-fill" data-promo-fill></div>
  </div>
  <div class="promo-foot">
    <span data-promo-left></span>
    <span data-i18n-vi={`Từ ${nextDay}: ${formatVnd(p.price!)}`} data-i18n-en={`From ${nextDay}: ${formatVnd(p.price!)}`}>Từ {nextDay}: {formatVnd(p.price!)}</span>
  </div>
</div>

<style>
  .promo {
    width: 100%;
    max-width: 560px;
    padding: 14px 16px;
    border-radius: 16px;
    text-align: left;
  }
  .promo-dark {
    margin: 24px auto 0;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
  }
  .promo-light {
    background: color-mix(in srgb, #ff7759 9%, var(--bg-card));
    border: 1px solid color-mix(in srgb, #ff7759 35%, var(--border));
    color: var(--ink);
  }
  .promo-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .promo-title {
    font-weight: 800;
    font-size: 0.92rem;
  }
  .promo-clock {
    display: inline-flex;
    gap: 6px;
  }
  .promo-clock > span {
    display: grid;
    justify-items: center;
    min-width: 42px;
    padding: 4px 6px;
    border-radius: 10px;
    line-height: 1.1;
  }
  .promo-dark .promo-clock > span {
    background: rgba(255, 255, 255, 0.12);
  }
  .promo-light .promo-clock > span {
    background: var(--bg-card);
    border: 1px solid var(--border);
  }
  .promo-clock b {
    font-size: 1.05rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }
  .promo-clock small {
    font-size: 0.62rem;
    opacity: 0.75;
  }
  .promo-track {
    margin-top: 12px;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
  }
  .promo-dark .promo-track {
    background: rgba(255, 255, 255, 0.15);
  }
  .promo-light .promo-track {
    background: color-mix(in srgb, #ff7759 15%, transparent);
  }
  .promo-fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #fbbf24, #ff7759, #ef4444);
    background-size: 200% 100%;
    animation: promo-shine 3s linear infinite;
    transition: width 0.6s ease;
  }
  @keyframes promo-shine {
    to { background-position: -200% 0; }
  }
  .promo-foot {
    margin-top: 8px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 0.8rem;
    opacity: 0.85;
  }
  @media (prefers-reduced-motion: reduce) {
    .promo-fill {
      animation: none;
    }
  }
</style>
