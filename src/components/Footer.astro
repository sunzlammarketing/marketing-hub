---
import { SOCIALS } from '../data/social';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo">
        <span class="logo-mark"><img src="/logo-mark.png" alt="" width="34" height="34" /></span>
        <span class="brand-word"><b>SUNZ</b><small>LÀM MARKETING</small></span>
      </a>
      <p data-i18n="footer.tagline">
        Nơi chia sẻ kiến thức Marketing dễ hiểu, thực tế và có thể áp dụng ngay.
      </p>
    </div>
    <div class="footer-social">
      <span class="fs-title" data-i18n="footer.follow">Theo dõi Sunz</span>
      <div class="fs-icons">
        {SOCIALS.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener"
            class="fs-link"
            style={`--c:${s.color}`}
            aria-label={`${s.name} ${s.handle}`}
            title={`${s.name} · ${s.handle}`}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={s.icon} fill="currentColor" /></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--panel);
    backdrop-filter: blur(8px);
    margin-top: 40px;
  }
  .footer-grid {
    padding-block: 36px 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
  }
  .fs-title {
    display: block;
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 12px;
    color: var(--ink);
  }
  .fs-icons {
    display: flex;
    gap: 10px;
  }
  .fs-link {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--ink-soft);
    transition: 0.15s;
  }
  .fs-link:hover {
    color: #fff;
    background: var(--c);
    border-color: var(--c);
    transform: translateY(-2px);
  }
  .footer-brand p {
    color: var(--ink-soft);
    margin: 12px 0 0;
    max-width: 440px;
    font-size: 0.95rem;
  }
  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 10px;
    color: var(--ink);
    font-weight: 800;
    font-size: 1.1rem;
  }
  .logo:hover {
    text-decoration: none;
  }
  /* Ô logo cao đúng bằng cụm chữ: đỉnh chữ SUNZ → chân dòng LÀM MARKETING (≈ 1.25em cỡ chữ SUNZ),
     đáy ô thẳng chân chữ LÀM MARKETING (margin-bottom bù phần dư dưới chân chữ) */
  .logo-mark {
    width: 2rem;
    height: 2rem;
    margin-bottom: 1px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .logo-mark img {
    width: 94%;
    height: 94%;
    object-fit: contain;
  }
  .logo b {
    color: var(--brand);
  }
  /* Chừa chỗ cho cột nút nổi (MXH + chat) ở góc phải để không che nội dung footer */
  @media (min-width: 761px) {
    .site-footer .container {
      padding-right: clamp(20px, calc(110px - (100vw - var(--max)) / 2), 110px);
    }
  }
  /* Điện thoại: chừa chỗ dưới cùng cho nút nổi (đặt cuối để thắng padding-block ở trên) */
  @media (max-width: 760px) {
    .footer-grid {
      padding-bottom: 96px;
    }
  }
</style>
