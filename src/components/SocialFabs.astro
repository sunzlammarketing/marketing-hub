---
// Cột nút liên hệ nhanh nổi bên phải (kiểu L'Angelulus), nằm ngay trên nút chat.
// Thứ tự từ trên xuống: Facebook → Instagram → TikTok. Link lấy từ src/data/social.ts.
import { SOCIALS } from '../data/social';
const url = (name: string) => SOCIALS.find((s) => s.name === name)?.url ?? '#';
const tiktok = SOCIALS.find((s) => s.name === 'TikTok')?.icon ?? '';
---

<div class="sfabs" id="sfabs" aria-label="Mạng xã hội Sunz">
  <a class="sfab sfab-fb" href={url('Facebook')} target="_blank" rel="noopener" aria-label="Facebook Sunz Làm Marketing">
    <span class="sfab-ico"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M14.2 9V6.9c0-.9.2-1.4 1.6-1.4H17V2.3c-.4-.05-1.4-.15-2.5-.15-2.6 0-4.3 1.55-4.3 4.4V9H8v3h2.2v9h3.6v-9H16l.5-3z" /></svg></span>
  </a>
  <a class="sfab sfab-ig" href={url('Instagram')} target="_blank" rel="noopener" aria-label="Instagram @sunzlammarketing">
    <span class="sfab-ico"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r=".9" fill="currentColor" stroke="none" /></svg></span>
  </a>
  <a class="sfab sfab-tt" href={url('TikTok')} target="_blank" rel="noopener" aria-label="TikTok @sunz.lam.marketing">
    <span class="sfab-ico"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={tiktok} /></svg></span>
  </a>
  <button type="button" class="sfab sfab-main" aria-label="Mạng xã hội" aria-expanded="false">
    <span class="sfab-ico">
      <svg class="ico-share" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
      <svg class="ico-x" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </span>
  </button>
</div>

<style>
  /* Nút chat 58px ở right:22 bottom:22 → cột này căn giữa theo nút chat, đặt ngay phía trên */
  .sfabs {
    position: fixed;
    right: 25px;
    bottom: 98px;
    z-index: 89;
    display: grid;
    gap: 14px;
    justify-items: center;
    transition: opacity 0.18s, visibility 0.18s;
  }
  /* Khung chat đang mở thì ẩn cột nút để khỏi đè */
  :global(body:has(.chat-panel.open)) .sfabs {
    opacity: 0;
    visibility: hidden;
  }
  .sfab {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 0;
    cursor: pointer;
    background: var(--fab);
    color: var(--fab-ink, #fff);
    box-shadow: 0 6px 18px rgba(20, 20, 60, 0.24);
    transition: transform 0.16s ease;
  }
  .sfab:hover {
    transform: scale(1.07);
    text-decoration: none;
  }
  /* Vòng sóng lan toả phía sau nút — hai vòng lệch pha, mỗi nút lệch nhịp một chút */
  .sfab::before,
  .sfab::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: var(--fab-ripple, var(--fab));
    animation: sfabRipple 2.2s ease-out infinite;
    animation-delay: var(--fab-delay, 0s);
  }
  .sfab::after {
    animation-delay: calc(var(--fab-delay, 0s) + 1.1s);
  }
  .sfab:hover::before,
  .sfab:hover::after {
    animation-play-state: paused;
    opacity: 0;
  }
  @keyframes sfabRipple {
    0% { transform: scale(1); opacity: 0.55; }
    70% { opacity: 0.12; }
    100% { transform: scale(1.9); opacity: 0; }
  }
  /* Icon: nhịp thở nhẹ + thi thoảng lắc để hút mắt */
  .sfab-ico {
    display: grid;
    place-items: center;
    animation: sfabBeat 2.2s ease-in-out infinite, sfabWobble 2s ease-in-out infinite;
    animation-delay: var(--fab-delay, 0s);
  }
  .sfab-ico svg {
    display: block;
    width: 26px;
    height: 26px;
  }
  @keyframes sfabBeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }
  @keyframes sfabWobble {
    0% { rotate: 0deg; }
    8% { rotate: -18deg; }
    16% { rotate: 16deg; }
    24% { rotate: -14deg; }
    32% { rotate: 12deg; }
    40%, 100% { rotate: 0deg; }
  }
  .sfab-fb { --fab: #1877f2; --fab-delay: 0s; }
  .sfab-ig {
    --fab: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
    --fab-ripple: #d6249f;
    --fab-delay: 0.35s;
  }
  .sfab-tt {
    --fab: #111;
    --fab-ripple: #25f4ee;
    --fab-delay: 0.7s;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3), -2px -2px 0 -0.5px #25f4ee inset, 2px 2px 0 -0.5px #fe2c55 inset;
  }
  .sfab-tt svg {
    filter: drop-shadow(-1.2px -1px 0 #25f4ee) drop-shadow(1.2px 1px 0 #fe2c55);
  }
  .sfab-main {
    display: none;
    --fab: linear-gradient(135deg, #1877f2, #d6249f);
    --fab-ripple: #8b5cf6;
  }

  @media (max-width: 760px) {
    .sfabs { right: 26px; gap: 12px; bottom: 94px; }
    .sfab { width: 48px; height: 48px; }
    .sfab-ico svg { width: 23px; height: 23px; }
    /* Điện thoại: chỉ hiện 1 nút để khỏi che nội dung; bấm vào mới bung 3 nút */
    .sfab-main { display: grid; }
    .sfabs:not(.open) > .sfab:not(.sfab-main) {
      opacity: 0;
      visibility: hidden;
      transform: translateY(24px) scale(0.6);
      pointer-events: none;
    }
    .sfabs > .sfab:not(.sfab-main) {
      transition: opacity 0.2s, transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.2s;
    }
    .sfabs.open .sfab-main .ico-share,
    .sfabs:not(.open) .sfab-main .ico-x { display: none; }
    .sfabs.open .sfab-main .sfab-ico { animation: none; }
    .sfabs.open .sfab-main::before,
    .sfabs.open .sfab-main::after { animation: none; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sfab::before, .sfab::after { animation: none; opacity: 0; }
    .sfab-ico { animation: none; }
    .sfab:hover { transform: none; }
  }
</style>

<script>
  const wrap = document.getElementById('sfabs');
  const main = wrap?.querySelector('.sfab-main');
  const toggle = (force?: boolean) => {
    if (!wrap) return;
    const open = force ?? !wrap.classList.contains('open');
    wrap.classList.toggle('open', open);
    main?.setAttribute('aria-expanded', String(open));
  };
  main?.addEventListener('click', () => toggle());
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (wrap?.classList.contains('open') && (!wrap.contains(t) || t.closest('a.sfab'))) toggle(false);
  });
</script>
