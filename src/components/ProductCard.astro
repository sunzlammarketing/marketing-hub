---
// Thẻ sản phẩm: bấm ảnh/tên → trang chi tiết; nút Mua ngay → mua thẳng.
import ProductCover from './ProductCover.astro';
import BuyButton from './BuyButton.astro';
import { productUrl, formatVnd, effectivePrice, type Product } from '../data/products';
interface Props {
  product: Product;
  href?: string; // trang chi tiết; mặc định /tai-lieu/<slug>
}
const { product: p, href } = Astro.props;
const url = href ?? productUrl(p);
const ep = effectivePrice(p);
const off = ep.off;
---

<article class="pd-card">
  <a href={url} class="pd-media" tabindex="-1" aria-hidden="true">
    <ProductCover product={p} />
  </a>
  <div class="pd-body">
    <span class="pd-tag" data-i18n-vi={p.tag.vi} data-i18n-en={p.tag.en}>{p.tag.vi}</span>
    <h3 class="pd-name">
      <a href={url} data-i18n-vi={p.name.vi} data-i18n-en={p.name.en}>{p.name.vi}</a>
    </h3>
    <p class="pd-desc" data-i18n-vi={p.desc.vi} data-i18n-en={p.desc.en}>{p.desc.vi}</p>
    <a href={url} class="pd-more">
      <span data-i18n-vi="Xem chi tiết" data-i18n-en="View details">Xem chi tiết</span> →
    </a>
    <div class="pd-foot">
      {ep.price != null ? (
        <div class="pd-prices" data-price-box data-until={ep.promo?.until} data-regular={p.price != null ? formatVnd(p.price) : undefined}>
          {off && (
            <span class="pd-old" data-pold>
              <s>{formatVnd(ep.old!)}</s> <b class="pd-off">-{off}%</b>
            </span>
          )}
          <span class="pd-price" data-pnow>{formatVnd(ep.price)}</span>
          {ep.promo && (
            <small class="pd-until" data-pold data-i18n-vi={`⏰ Ưu đãi đến ${new Date(ep.promo.until).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', timeZone: 'Asia/Ho_Chi_Minh' })}`} data-i18n-en={`⏰ Offer ends ${new Date(ep.promo.until).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', timeZone: 'Asia/Ho_Chi_Minh' })}`}>
              ⏰ Ưu đãi đến {new Date(ep.promo.until).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', timeZone: 'Asia/Ho_Chi_Minh' })}
            </small>
          )}
        </div>
      ) : (
        <span class="pd-price pd-price-ask" data-i18n-vi="Liên hệ" data-i18n-en="Contact us">Liên hệ</span>
      )}
      <BuyButton product={p} />
    </div>
  </div>
</article>

<style>
  .pd-card {
    display: flex;
    flex-direction: column;
    border-radius: 28px;
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.07), 0 2px 4px -2px rgba(15, 23, 42, 0.05);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .pd-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -12px rgba(15, 23, 42, 0.22);
  }
  .pd-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .pd-media :global(.pc-img),
  .pd-media :global(.pc-icon) {
    transition: transform 0.3s ease;
  }
  .pd-card:hover .pd-media :global(.pc-img) {
    transform: scale(1.04);
  }
  .pd-card:hover .pd-media :global(.pc-icon) {
    transform: rotate(-6deg) scale(1.06);
  }
  .pd-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px 22px 22px;
  }
  .pd-tag {
    align-self: flex-start;
    font-size: 0.8rem;
    font-weight: 600;
    color: #e2553b;
    background: color-mix(in srgb, #ff7759 14%, transparent);
    padding: 5px 12px;
    border-radius: 999px;
  }
  .pd-name {
    margin: 14px 0 8px;
    font-size: 1.2rem;
    font-weight: 900;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .pd-name a {
    color: var(--ink);
  }
  .pd-name a:hover {
    color: var(--brand);
    text-decoration: none;
  }
  .pd-desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pd-more {
    align-self: flex-start;
    margin: 10px 0 16px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--brand);
  }
  .pd-foot {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .pd-price {
    font-size: 1.45rem;
    font-weight: 900;
    color: var(--brand);
    letter-spacing: -0.01em;
  }
  .pd-prices {
    display: grid;
    line-height: 1.15;
  }
  .pd-old {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }
  .pd-old s {
    text-decoration-thickness: 1.5px;
  }
  .pd-off {
    font-size: 0.72rem;
    font-weight: 800;
    color: #fff;
    background: #ef4444;
    padding: 2px 6px;
    border-radius: 6px;
  }
  .pd-until {
    font-size: 0.74rem;
    font-weight: 700;
    color: #e2553b;
    margin-top: 2px;
  }
  .pd-price-ask {
    font-size: 1.1rem;
    color: var(--ink-soft);
  }
  :global([data-theme='dark']) .pd-tag {
    color: #ffa48f;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .pd-tag {
      color: #ffa48f;
    }
  }
  @media (max-width: 600px) {
    .pd-card {
      border-radius: 22px;
    }
  }
</style>
