---
// Cửa sổ thanh toán VietQR, 2 bước:
//  1. Khách nhập SĐT/Zalo (bắt buộc), họ tên, email → đơn được lưu vào Google Sheet (nếu có ORDER_SHEET_URL).
//  2. Hiện QR; nội dung CK = "SUNZ <mã SP> <SĐT>" → khách không nhắn thì xem sao kê vẫn có SĐT để liên hệ.
// Mở bởi nút [data-pay] trong BuyButton. Đặt 1 lần trên mỗi trang có nút mua.
import { BANK, ORDER_SHEET_URL } from '../data/payment';
import { MESSENGER } from '../data/products';
---

<dialog class="pay" id="pay-modal" data-bin={BANK.bin} data-account={BANK.account} data-holder={BANK.holder} data-messenger={MESSENGER} data-sheet={ORDER_SHEET_URL} aria-labelledby="pay-title">
  <div class="pay-box">
    <button type="button" class="pay-x" data-pay-close aria-label="Đóng">✕</button>
    <h2 id="pay-title" data-i18n-vi="Thanh toán chuyển khoản" data-i18n-en="Bank transfer payment">Thanh toán chuyển khoản</h2>
    <p class="pay-product" data-pay-name></p>

    <!-- Bước 1: thông tin liên hệ -->
    <form class="pay-form" data-pay-step="info" novalidate>
      <p class="pay-form-lead" data-i18n-vi="Tài liệu được gửi qua email sau khi Sunz xác nhận thanh toán." data-i18n-en="The file is sent to your email once Sunz confirms payment.">
        Tài liệu được gửi qua email sau khi Sunz xác nhận thanh toán.
      </p>
      <label>
        <span><span data-i18n-vi="Email nhận tài liệu" data-i18n-en="Email to receive the file">Email nhận tài liệu</span> <b class="req">*</b></span>
        <input name="email" type="email" autocomplete="email" placeholder="ban@email.com" required />
      </label>
      <div class="pay-form-row">
        <label>
          <span><span data-i18n-vi="Số điện thoại / Zalo" data-i18n-en="Phone / Zalo">Số điện thoại / Zalo</span> <b class="req">*</b></span>
          <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="09xx xxx xxx" required />
        </label>
        <label>
          <span data-i18n-vi="Họ tên" data-i18n-en="Name">Họ tên</span>
          <input name="name" type="text" autocomplete="name" placeholder="Nguyễn Văn A" />
        </label>
      </div>
      <input class="pay-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="pay-err" data-pay-err hidden></p>
      <button type="submit" class="pay-next">
        <span data-i18n-vi="Tiếp tục — hiện mã QR thanh toán" data-i18n-en="Continue — show payment QR">Tiếp tục — hiện mã QR thanh toán</span> →
      </button>
      <p class="pay-privacy" data-i18n-vi="🔒 Thông tin chỉ dùng để gửi tài liệu và hỗ trợ đơn hàng." data-i18n-en="🔒 Your details are only used to deliver the file and support your order.">
        🔒 Thông tin chỉ dùng để gửi tài liệu và hỗ trợ đơn hàng.
      </p>
      <p class="pay-terms">
        Bằng việc tiếp tục, bạn đồng ý với <a href="/chinh-sach/dieu-khoan-su-dung" target="_blank">Điều khoản sử dụng</a>,
        <a href="/chinh-sach/chinh-sach-bao-mat" target="_blank">Chính sách bảo mật</a> và
        <a href="/chinh-sach/chinh-sach-doi-tra-hoan-tien" target="_blank">Chính sách hoàn tiền</a>.
      </p>
    </form>

    <!-- Bước 2: mã QR -->
    <div data-pay-step="qr" hidden>
    <div class="pay-grid">
      <div class="pay-qr">
        <img data-pay-qr alt="Mã QR thanh toán" width="300" height="340" />
        <a class="pay-save" data-pay-save target="_blank" rel="noopener" data-i18n-vi="Mở ảnh QR để lưu" data-i18n-en="Open QR image to save">Mở ảnh QR để lưu</a>
      </div>

      <dl class="pay-info">
        <div>
          <dt data-i18n-vi="Ngân hàng" data-i18n-en="Bank">Ngân hàng</dt>
          <dd><b>{BANK.name}</b></dd>
        </div>
        <div>
          <dt data-i18n-vi="Số tài khoản" data-i18n-en="Account number">Số tài khoản</dt>
          <dd><b>{BANK.account}</b> <button type="button" class="pay-copy" data-copy-val={BANK.account}>Copy</button></dd>
        </div>
        <div>
          <dt data-i18n-vi="Chủ tài khoản" data-i18n-en="Account holder">Chủ tài khoản</dt>
          <dd><b>{BANK.holder}</b></dd>
        </div>
        <div>
          <dt data-i18n-vi="Số tiền" data-i18n-en="Amount">Số tiền</dt>
          <dd><b class="pay-amount" data-pay-amount></b> <button type="button" class="pay-copy" data-pay-copy-amount>Copy</button></dd>
        </div>
        <div class="pay-note-row">
          <dt data-i18n-vi="Nội dung chuyển khoản" data-i18n-en="Transfer note">Nội dung chuyển khoản</dt>
          <dd><b class="pay-code" data-pay-code></b> <button type="button" class="pay-copy" data-pay-copy-code>Copy</button></dd>
        </div>
      </dl>
    </div>

    <ol class="pay-steps">
      <li data-i18n-vi="Mở app ngân hàng, quét mã QR (trên điện thoại: lưu ảnh QR rồi chọn quét từ thư viện ảnh)." data-i18n-en="Open your banking app and scan the QR (on a phone: save the QR image, then scan it from your gallery).">
        Mở app ngân hàng, quét mã QR (trên điện thoại: lưu ảnh QR rồi chọn quét từ thư viện ảnh).
      </li>
      <li data-i18n-vi="Giữ nguyên số tiền và nội dung chuyển khoản, xác nhận thanh toán." data-i18n-en="Keep the amount and transfer note as filled in, then confirm.">
        Giữ nguyên số tiền và nội dung chuyển khoản, xác nhận thanh toán.
      </li>
      <li data-i18n-vi="Bấm “Tôi đã chuyển khoản”. Sunz xác nhận và gửi link tải tài liệu vào email của bạn." data-i18n-en="Tap “I've paid”. Sunz confirms and emails you the download link.">
        Bấm “Tôi đã chuyển khoản”. Sunz xác nhận và gửi link tải tài liệu vào email của bạn.
      </li>
    </ol>

    <a class="pay-done" data-pay-done target="_blank" rel="noopener">
      ✅ <span data-i18n-vi="Tôi đã chuyển khoản" data-i18n-en="I've paid">Tôi đã chuyển khoản</span>
    </a>
    <button type="button" class="pay-back" data-pay-back>
      ← <span data-i18n-vi="Sửa thông tin" data-i18n-en="Edit details">Sửa thông tin</span>
    </button>
    </div>
    <div class="pay-toast" role="status" aria-live="polite"></div>
  </div>
</dialog>

<style>
  .pay {
    width: min(720px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    padding: 0;
    border: none;
    border-radius: 24px;
    background: var(--bg-card);
    color: var(--ink);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.45);
  }
  .pay::backdrop {
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(3px);
  }
  .pay-box {
    position: relative;
    padding: 26px 28px 28px;
  }
  .pay-x {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--ink-soft);
    font-size: 1rem;
    cursor: pointer;
  }
  .pay h2 {
    margin: 0;
    padding-right: 44px;
    font-size: clamp(1.15rem, 4.5vw, 1.35rem);
    font-weight: 900;
  }
  .pay-product {
    margin: 4px 40px 18px 0;
    color: var(--ink-soft);
    font-weight: 600;
  }
  .pay-form {
    display: grid;
    gap: 14px;
  }
  .pay-form-lead {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
  .pay-form label {
    display: grid;
    gap: 6px;
    font-size: 0.86rem;
    font-weight: 700;
  }
  .pay-form .req {
    color: #ef4444;
  }
  .pay-form input {
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--ink);
  }
  .pay-form input:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 18%, transparent);
  }
  .pay-form input[aria-invalid='true'] {
    border-color: #ef4444;
  }
  .pay-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .pay-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .pay-err {
    margin: 0;
    color: #dc2626;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .pay-terms {
    margin: 6px 0 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--ink-faint);
    text-align: center;
  }
  .pay-terms a {
    color: var(--ink-soft);
    text-decoration: underline;
  }
  .pay-next {
    font: inherit;
    font-weight: 800;
    font-size: 1rem;
    border: 0;
    cursor: pointer;
    padding: 14px;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, #4f46e5, #3730a3);
    box-shadow: 0 10px 22px -10px rgba(55, 48, 163, 0.75);
  }
  .pay-privacy {
    margin: -4px 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .pay-back {
    display: block;
    margin: 12px auto 0;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .pay-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 22px;
    align-items: start;
  }
  .pay-qr {
    display: grid;
    gap: 8px;
    justify-items: center;
  }
  .pay-qr img {
    width: 100%;
    height: auto;
    aspect-ratio: 300 / 340;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--border);
    object-fit: contain;
  }
  .pay-save {
    font-size: 0.82rem;
    font-weight: 600;
  }
  .pay-info {
    margin: 0;
    display: grid;
    gap: 2px;
  }
  .pay-info > div {
    padding: 10px 0;
    border-bottom: 1px dashed var(--border);
  }
  .pay-info dt {
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
  .pay-info dd {
    margin: 2px 0 0;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 1.02rem;
  }
  .pay-amount {
    color: var(--brand);
    font-size: 1.2rem;
  }
  .pay-note-row {
    background: color-mix(in srgb, #ff7759 10%, transparent);
    border-radius: 12px;
    padding: 10px 12px !important;
    border-bottom: none !important;
    margin-top: 6px;
  }
  .pay-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.04em;
    color: #c2410c;
  }
  .pay-copy {
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand);
    background: var(--brand-soft);
    border: 0;
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
  }
  .pay-steps {
    margin: 18px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 4px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .pay-done {
    margin-top: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px;
    border-radius: 14px;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, #10b981, #047857);
    box-shadow: 0 10px 22px -10px rgba(4, 120, 87, 0.7);
  }
  .pay-done:hover {
    text-decoration: none;
    filter: brightness(1.05);
  }
  .pay-toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 2147483647;
    transform: translate(-50%, 20px);
    opacity: 0;
    pointer-events: none;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.9rem;
    font-weight: 600;
    transition: 0.2s;
  }
  .pay-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  :global([data-theme='dark']) .pay-code {
    color: #fdba74;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .pay-code {
      color: #fdba74;
    }
  }
  @media (max-width: 640px) {
    .pay-box {
      padding: 22px 18px 20px;
    }
    .pay-grid,
    .pay-form-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .pay-qr img {
      max-width: 240px;
    }
  }
</style>

<script>
  const dlg = document.getElementById('pay-modal') as HTMLDialogElement | null;
  const toast = dlg?.querySelector('.pay-toast') as HTMLElement | null;
  if (dlg) {
    const $ = <T extends HTMLElement>(s: string) => dlg.querySelector(s) as T;
    const lang = () => (document.documentElement.getAttribute('lang') === 'en' ? 'en' : 'vi');
    const vnd = (n: number) => n.toLocaleString('vi-VN') + ' ₫';
    let current = { amount: 0, code: '' };
    let timer: number | undefined;

    const notify = (msg: string) => {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(timer);
      timer = window.setTimeout(() => toast.classList.remove('show'), 1600);
    };
    const copy = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.append(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      notify(lang() === 'en' ? '✓ Copied' : '✓ Đã copy');
    };

    const form = $<HTMLFormElement>('form[data-pay-step="info"]');
    const stepInfo = form;
    const stepQr = $('[data-pay-step="qr"]');
    const errBox = $('[data-pay-err]');
    const sheet = dlg.dataset.sheet || '';
    let product = { amount: 0, pcode: '', name: '' };

    const showStep = (step: 'info' | 'qr') => {
      stepInfo.hidden = step !== 'info';
      stepQr.hidden = step !== 'qr';
    };
    // Gửi đơn lên Google Sheet (không chặn khách nếu lỗi)
    const saveOrder = (data: Record<string, unknown>) => {
      if (!sheet) return;
      fetch(sheet, { method: 'POST', mode: 'no-cors', body: JSON.stringify(data) }).catch(() => {});
    };
    // Nhớ thông tin khách cho lần mua sau (chỉ trên máy của khách)
    const remember = (d?: Record<string, string>) => {
      try {
        if (d) localStorage.setItem('sunz-buyer', JSON.stringify(d));
        else return JSON.parse(localStorage.getItem('sunz-buyer') || '{}');
      } catch {
        return {};
      }
    };

    document.querySelectorAll<HTMLElement>('[data-pay]').forEach((btn) =>
      btn.addEventListener('click', () => {
        product = {
          // Ưu đãi hết hạn (trang chưa build lại) → tính giá thường
          amount: Number(
            btn.dataset.until && Date.now() > Date.parse(btn.dataset.until) ? btn.dataset.regular : btn.dataset.price
          ),
          pcode: btn.dataset.code || '',
          name: (lang() === 'en' ? btn.dataset.nameEn : btn.dataset.nameVi) || '',
        };
        $('[data-pay-name]').textContent = product.name;
        const saved = remember() || {};
        (['phone', 'name', 'email'] as const).forEach((k) => {
          const el = form.elements.namedItem(k) as HTMLInputElement;
          el.value = saved[k] || '';
          el.removeAttribute('aria-invalid');
        });
        errBox.hidden = true;
        showStep('info');
        dlg.showModal();
      })
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = form.elements;
      const phoneEl = f.namedItem('phone') as HTMLInputElement;
      const emailEl = f.namedItem('email') as HTMLInputElement;
      const name = (f.namedItem('name') as HTMLInputElement).value.trim();
      const email = emailEl.value.trim();
      // Chuẩn hoá SĐT VN: bỏ khoảng trắng/dấu, +84 → 0, phải đủ 10 số
      const phone = phoneEl.value.replace(/[\s.\-()]/g, '').replace(/^\+?84/, '0');
      const phoneOk = /^0\d{9}$/.test(phone);
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      phoneEl.setAttribute('aria-invalid', String(!phoneOk));
      emailEl.setAttribute('aria-invalid', String(!emailOk));
      if (!phoneOk || !emailOk) {
        errBox.textContent = !emailOk
          ? lang() === 'en' ? 'Please enter a valid email to receive the file.' : 'Vui lòng nhập email hợp lệ để nhận tài liệu.'
          : lang() === 'en' ? 'Please enter a valid 10-digit phone number.' : 'Vui lòng nhập số điện thoại hợp lệ (10 số).';
        errBox.hidden = false;
        (!emailOk ? emailEl : phoneEl).focus();
        return;
      }
      errBox.hidden = true;
      remember({ phone, name, email });

      // Nội dung CK: SUNZ + mã sản phẩm + SĐT khách → xem sao kê là biết ai mua gì
      const code = `SUNZ ${product.pcode} ${phone}`;
      const amount = product.amount;
      current = { amount, code };

      const qr =
        `https://img.vietqr.io/image/${dlg.dataset.bin}-${dlg.dataset.account}-compact.png` +
        `?amount=${amount}&addInfo=${encodeURIComponent(code)}&accountName=${encodeURIComponent(dlg.dataset.holder || '')}`;
      $<HTMLImageElement>('[data-pay-qr]').src = qr;
      $<HTMLAnchorElement>('[data-pay-save]').href = qr;
      $('[data-pay-amount]').textContent = vnd(amount);
      $('[data-pay-code]').textContent = code;

      const msg =
        lang() === 'en'
          ? `Hi Sunz, I've paid ${vnd(amount)} for "${product.name}". Transfer note: ${code}`
          : `Xin chào Sunz, mình đã chuyển khoản ${vnd(amount)} mua "${product.name}". Nội dung CK: ${code}`;
      $<HTMLAnchorElement>('[data-pay-done]').href = `${dlg.dataset.messenger}?text=${encodeURIComponent(msg)}`;

      saveOrder({
        code,
        product: product.name,
        amount,
        name,
        phone,
        email,
        page: location.pathname,
        website: (f.namedItem('website') as HTMLInputElement).value,
      });
      showStep('qr');
    });

    $('[data-pay-back]').addEventListener('click', () => showStep('info'));
    $('[data-pay-done]').addEventListener('click', () => saveOrder({ action: 'claim', code: current.code }));

    dlg.querySelector('[data-pay-close]')?.addEventListener('click', () => dlg.close());
    // Bấm ra ngoài khung để đóng
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.querySelectorAll<HTMLElement>('[data-copy-val]').forEach((b) =>
      b.addEventListener('click', () => copy(b.dataset.copyVal!))
    );
    dlg.querySelector('[data-pay-copy-amount]')?.addEventListener('click', () => copy(String(current.amount)));
    dlg.querySelector('[data-pay-copy-code]')?.addEventListener('click', () => copy(current.code));
  }
</script>
