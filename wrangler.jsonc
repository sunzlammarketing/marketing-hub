// Cấu hình Cloudflare Workers: phục vụ web tĩnh Astro đã build ở ./dist
// Chuyển hướng đọc từ public/_redirects (được copy vào dist khi build)
{
  "name": "sunzlammarketing",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Link trong web viết dạng /blog (không "/" cuối) → phục vụ thẳng, không chuyển hướng thêm
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
