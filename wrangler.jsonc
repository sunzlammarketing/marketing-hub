// Cấu hình Cloudflare Workers: web tĩnh Astro đã build ở ./dist + worker/index.js cho /dl
// Chuyển hướng đọc từ public/_redirects (được copy vào dist khi build)
{
  "name": "sunzlammarketing",
  "compatibility_date": "2026-10-01",
  // Worker xử lý /dl (tải tài liệu có bảo vệ); các đường dẫn khác trả file tĩnh qua binding ASSETS
  "main": "./worker/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // Link trong web viết dạng /blog (không "/" cuối) → phục vụ thẳng, không chuyển hướng thêm
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // KV đếm lượt dùng công cụ kiểm tra SEO (10 lượt/IP/giờ) — xem worker/seo-api.js
  "kv_namespaces": [{ "binding": "RATE_KV", "id": "bf09b2e99bf943f1874800b1086c3cc7" }]
  // Secret PAGESPEED_API_KEY: thêm trên dashboard Cloudflare (Settings → Variables and Secrets), không ghi ở đây
}
